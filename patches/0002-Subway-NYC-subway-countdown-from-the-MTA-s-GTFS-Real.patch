+static void test_board_countdown_ticks_between_polls() {
+  const FeedSnapshot s = snap({T0 + 250, T0 + 671, T0 + 1200});
+  BoardView v = viewAt(s, T0, 120);
+  TEST_ASSERT_EQUAL(2, v.trains);
+  TEST_ASSERT_EQUAL(4, v.minutes[0]);   // 250 s -> 4 min (floor)
+  TEST_ASSERT_EQUAL(11, v.minutes[1]);  // 671 s -> 11 min
+  v = viewAt(s, T0 + 100, 120);  // 100 s after the feed, still fresh
+  TEST_ASSERT_EQUAL(2, v.minutes[0]);   // 150 s -> 2 min
+  TEST_ASSERT_EQUAL(9, v.minutes[1]);   // 571 s -> 9 min
+  v = viewAt(s, T0 + 200, 1000);
+  TEST_ASSERT_EQUAL(BoardView::kNow, v.minutes[0]);  // 50 s -> NOW
+  v = viewAt(s, T0 + 275, 1000);   // 25 s after the first: still NOW (grace)
+  TEST_ASSERT_EQUAL(BoardView::kNow, v.minutes[0]);
+  v = viewAt(s, T0 + 290, 1000);   // 40 s after: gone, next two move up
+  TEST_ASSERT_EQUAL(6, v.minutes[0]);
+  TEST_ASSERT_EQUAL(15, v.minutes[1]);
+  // cap
+  v = viewAt(snap({T0 + 200 * 60}), T0, 120);
+  TEST_ASSERT_EQUAL(99, v.minutes[0]);
+  TEST_ASSERT_EQUAL(1, v.trains);
+}
