+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// What the display may say about the next trains, given the last fetch and the wall clock. Kept free
+// of Arduino so the rules are unit-tested on the host:
+//
+//   NoClock      the device does not know the time yet: no countdown can be computed
+//   Loading      no fetch has finished since boot
+//   Live         a fresh feed lists at least one train still to come
+//   NoArrivals   a fresh, valid feed lists none (not a suspension -- just nothing predicted)
+//   Stale        the last good feed is older than the stale threshold
+//   Unavailable  the last attempt failed (network, HTTP, TLS or parse) and nothing fresh is left
+//
+// Countdowns are recomputed from the device clock on every frame, so they tick down between polls.
+
+#include <cstddef>
+#include <cstdint>
+
+namespace awtrix::transit {
+
+enum class BoardState : uint8_t { NoClock, Loading, Live, NoArrivals, Stale, Unavailable };
+
+const char* boardStateName(BoardState s);
+
+struct FeedSnapshot {
+  static constexpr std::size_t kMax = 8;
+  bool everFinished = false;      // any attempt has completed, good or bad
+  bool lastOk = false;            // the most recent attempt decoded a valid feed
+  int64_t feedTimestamp = 0;      // header.timestamp of the last good feed, Unix seconds
+  int64_t receivedEpoch = 0;      // device time when that feed arrived, Unix seconds
+  uint32_t failures = 0;          // consecutive failed attempts
+  int64_t times[kMax] = {};       // arrival times, ascending, Unix seconds
+  std::size_t count = 0;
+};
+
+struct BoardView {
+  static constexpr int kNow = 0;  // minutes value shown as NOW
+  BoardState state = BoardState::NoClock;
+  int minutes[2] = {-1, -1};      // -1 = no train in this slot; 0 = NOW; capped at 99
+  int trains = 0;
+};
+
+// A train whose time passed less than kGraceSec ago is still shown as NOW: the prediction is
+// rounded and the doors may still be open.
+constexpr int64_t kGraceSec = 30;
+// A feed stamped further ahead than this is not trusted as fresh (one of the two clocks is wrong).
+constexpr int64_t kFutureToleranceSec = 300;
+
+inline BoardView viewAt(const FeedSnapshot& s, int64_t nowEpochSec, int64_t staleSec) {
+  BoardView v;
+  if (nowEpochSec <= 0) return v;  // NoClock
+  if (!s.everFinished) {
+    v.state = BoardState::Loading;
+    return v;
+  }
+  const bool haveGood = s.feedTimestamp > 0;
+  const int64_t age = nowEpochSec - s.feedTimestamp;
+  const bool fresh = haveGood && age <= staleSec && age >= -kFutureToleranceSec;
+  if (!fresh) {
+    v.state = (!s.lastOk || !haveGood) ? BoardState::Unavailable : BoardState::Stale;
+    return v;
+  }
+  for (std::size_t i = 0; i < s.count && v.trains < 2; ++i) {
+    const int64_t dt = s.times[i] - nowEpochSec;
+    if (dt < -kGraceSec) continue;
+    int m = dt < 60 ? BoardView::kNow : static_cast<int>(dt / 60);
+    if (m > 99) m = 99;
+    v.minutes[v.trains++] = m;
+  }
+  v.state = v.trains ? BoardState::Live : BoardState::NoArrivals;
+  return v;
+}
+
+// One state for a screen that shows several lines: live if any line is; otherwise a problem worth
+// a gray screen (stale, unavailable) before the quiet states.
+inline BoardState combinedState(const BoardView* v, int n) {
+  static constexpr BoardState kRank[] = {BoardState::Live, BoardState::Stale, BoardState::Unavailable,
+                                         BoardState::Loading, BoardState::NoArrivals, BoardState::NoClock};
+  for (BoardState s : kRank)
+    for (int i = 0; i < n; ++i)
+      if (v[i].state == s) return s;
+  return BoardState::NoClock;
+}
+
+inline const char* boardStateName(BoardState s) {
+  switch (s) {
+    case BoardState::NoClock: return "no_clock";
+    case BoardState::Loading: return "loading";
+    case BoardState::Live: return "live";
+    case BoardState::NoArrivals: return "no_arrivals";
+    case BoardState::Stale: return "stale";
+    case BoardState::Unavailable: return "unavailable";
+  }
+  return "?";
+}
+
+// Retry pacing: the normal interval while fetches succeed, then 15 s, 30 s, 60 s, ... up to
+// 5 minutes after consecutive failures, so a dead network or a down MTA costs little.
+inline int64_t nextDelayMs(uint32_t failures, int64_t intervalMs) {
+  if (failures == 0) return intervalMs;
+  int64_t d = 15000;
+  for (uint32_t i = 1; i < failures && d < 300000; ++i) d *= 2;
+  return d > 300000 ? 300000 : d;
+}
+
+}  // namespace awtrix::transit
diff --git a/src/core/transit/GtfsRtDecoder.cpp b/src/core/transit/GtfsRtDecoder.cpp
new file mode 100644
index 0000000..d074f6d
--- /dev/null
+++ b/src/core/transit/GtfsRtDecoder.cpp
@@ -0,0 +1,388 @@
+// B-train gift clock addition (not upstream AWTRIX NG). See GtfsRtDecoder.h.
+
+#include "core/transit/GtfsRtDecoder.h"
+
+#include <cstring>
+
+namespace awtrix::transit {
+
+namespace {
+constexpr uint64_t kNoEnd = UINT64_MAX;
+constexpr uint32_t kMaxFieldNumber = (1u << 29) - 1;
+
+constexpr uint8_t kVarint = 0, kFixed64 = 1, kLen = 2, kFixed32 = 5;
+
+// TripDescriptor.ScheduleRelationship
+constexpr uint32_t kTripCanceled = 3, kTripDeleted = 7;
+// StopTimeUpdate.ScheduleRelationship
+constexpr uint32_t kStopSkipped = 1;
+}  // namespace
+
+const char* decodeErrorName(DecodeError e) {
+  switch (e) {
+    case DecodeError::None: return "none";
+    case DecodeError::BadVarint: return "bad varint";
+    case DecodeError::BadWireType: return "bad wire type";
+    case DecodeError::BadFieldNumber: return "bad field number";
+    case DecodeError::LengthOverrun: return "length overrun";
+    case DecodeError::Oversized: return "oversized";
+    case DecodeError::Truncated: return "truncated";
+  }
+  return "?";
+}
+
+bool GtfsRtDecoder::Str::equals(const Str& o) const {
+  return set && o.set && !overflow && !o.overflow && len == o.len && std::memcmp(buf, o.buf, len) == 0;
+}
+
+static void copyId(const char* in, char* buf, uint8_t& len, bool& overflow, bool& set) {
+  len = 0;
+  overflow = false;
+  set = in != nullptr;
+  if (!in) return;
+  const std::size_t n = std::strlen(in);
+  if (n > GtfsRtDecoder::kMaxId) {
+    overflow = true;
+    return;
+  }
+  std::memcpy(buf, in, n);
+  buf[n] = 0;
+  len = static_cast<uint8_t>(n);
+}
+
+void GtfsRtDecoder::begin(const char* route, const char* stop, int64_t cutoffSec, uint64_t maxBytes) {
+  *this = GtfsRtDecoder();
+  copyId(route, route_.buf, route_.len, route_.overflow, route_.set);
+  copyId(stop, stop_.buf, stop_.len, stop_.overflow, stop_.set);
+  cutoff_ = cutoffSec;
+  maxBytes_ = maxBytes;
+  stack_[0] = Frame{Msg::Feed, kNoEnd};
+  depth_ = 1;
+}
+
+void GtfsRtDecoder::beginAlerts(const char* const* routes, int n, int64_t nowSec, uint64_t maxBytes) {
+  begin(nullptr, nullptr, 0, maxBytes);
+  alertsMode_ = true;
+  now_ = nowSec;
+  for (int i = 0; i < n && i < kMaxAlertRoutes; ++i) {
+    Str& r = alertRoutes_[i];
+    copyId(routes[i], r.buf, r.len, r.overflow, r.set);
+    ++nAlertRoutes_;
+  }
+}
+
+bool GtfsRtDecoder::isDisruption(const char* t) {
+  if (!t) return true;
+  static constexpr const char* kNot[] = {"Planned", "Extra Service", "Station Notice", "Boarding Change",
+                                         "Special Schedul"};
+  for (const char* p : kNot)
+    if (std::strncmp(t, p, std::strlen(p)) == 0) return false;
+  return true;
+}
+
+bool GtfsRtDecoder::fail(DecodeError e) {
+  if (error_ == DecodeError::None) error_ = e;
+  return false;
+}
+
+bool GtfsRtDecoder::feed(const uint8_t* data, std::size_t len) {
+  if (error_ != DecodeError::None) return false;
+  std::size_t i = 0;
+  while (i < len) {
+    if (maxBytes_ && pos_ >= maxBytes_) return fail(DecodeError::Oversized);
+    // A field boundary at a nested message's end has already popped it; still being inside one
+    // here means a field runs over the end of the message that holds it.
+    if (stack_[depth_ - 1].end != kNoEnd && pos_ >= stack_[depth_ - 1].end)
+      return fail(DecodeError::LengthOverrun);
+
+    if (st_ == St::Skip || st_ == St::String) {
+      std::size_t n = len - i;
+      if (n > remain_) n = static_cast<std::size_t>(remain_);
+      if (maxBytes_ && pos_ + n > maxBytes_) n = static_cast<std::size_t>(maxBytes_ - pos_);
+      if (st_ == St::String && target_) {
+        for (std::size_t k = 0; k < n; ++k) {
+          if (target_->len < kMaxId) target_->buf[target_->len++] = static_cast<char>(data[i + k]);
+          else target_->overflow = true;
+        }
+        target_->buf[target_->len] = 0;
+      }
+      i += n;
+      pos_ += n;
+      remain_ -= n;
+      if (remain_ == 0) {
+        st_ = St::Tag;
+        target_ = nullptr;
+        if (!fieldDone()) return false;
+      }
+      continue;
+    }
+
+    const uint8_t b = data[i++];
+    ++pos_;
+    // Tag, Varint and Len all read one varint.
+    if (shift_ >= 64 || (shift_ == 63 && (b & 0x7E))) return fail(DecodeError::BadVarint);
+    acc_ |= static_cast<uint64_t>(b & 0x7F) << shift_;
+    shift_ += 7;
+    if (b & 0x80) continue;
+    const uint64_t v = acc_;
+    acc_ = 0;
+    shift_ = 0;
+
+    switch (st_) {
+      case St::Tag: {
+        const uint64_t f = v >> 3;
+        wire_ = static_cast<uint8_t>(v & 7);
+        if (f == 0 || f > kMaxFieldNumber) return fail(DecodeError::BadFieldNumber);
+        field_ = static_cast<uint32_t>(f);
+        if (wire_ == kVarint) st_ = St::Varint;
+        else if (wire_ == kLen) st_ = St::Len;
+        else if (wire_ == kFixed64 || wire_ == kFixed32) {
+          remain_ = wire_ == kFixed64 ? 8 : 4;
+          if (stack_[depth_ - 1].end != kNoEnd && pos_ + remain_ > stack_[depth_ - 1].end)
+            return fail(DecodeError::LengthOverrun);
+          st_ = St::Skip;
+        } else return fail(DecodeError::BadWireType);
+        break;
+      }
+      case St::Varint:
+        onVarint(v);
+        st_ = St::Tag;
+        if (!fieldDone()) return false;
+        break;
+      case St::Len:
+        if (!onLength(v)) return false;
+        break;
+      default:
+        break;
+    }
+  }
+  return true;
+}
+
+// After a complete field: close every nested message that ends exactly here.
+bool GtfsRtDecoder::fieldDone() {
+  while (depth_ > 1 && stack_[depth_ - 1].end == pos_) {
+    closeMsg(stack_[depth_ - 1].msg);
+    --depth_;
+  }
+  return true;
+}
+
+void GtfsRtDecoder::onVarint(uint64_t v) {
+  const Msg m = stack_[depth_ - 1].msg;
+  switch (m) {
+    case Msg::Header:
+      if (field_ == 3) headerTs_ = v;
+      break;
+    case Msg::Entity:
+      if (field_ == 2) entDeleted_ = v != 0;
+      break;
+    case Msg::Trip:
+      if (field_ == 4) tripRel_ = static_cast<uint32_t>(v);
+      break;
+    case Msg::StopTime:
+      if (field_ == 5) stuRel_ = static_cast<uint32_t>(v);
+      break;
+    case Msg::Arrival:
+    case Msg::Departure:
+      if (field_ == 2) evTime_ = static_cast<int64_t>(v);
+      break;
+    case Msg::Period:
+      if (field_ == 1) perStart_ = v;
+      else if (field_ == 2) perEnd_ = v;
+      break;
+    default:
+      break;
+  }
+}
+
+bool GtfsRtDecoder::onLength(uint64_t len) {
+  const uint64_t parentEnd = stack_[depth_ - 1].end;
+  if (parentEnd != kNoEnd && (len > parentEnd - pos_)) return fail(DecodeError::LengthOverrun);
+  if (maxBytes_ && len > maxBytes_ - pos_) return fail(DecodeError::Oversized);
+
+  const Msg m = stack_[depth_ - 1].msg;
+  Msg child = Msg::Feed;
+  bool nested = false;
+  Str* str = nullptr;
+  switch (m) {
+    case Msg::Feed:
+      if (field_ == 1) { child = Msg::Header; nested = true; }
+      else if (field_ == 2) { child = Msg::Entity; nested = true; }
+      break;
+    case Msg::Entity:
+      if (field_ == 3 && !alertsMode_) { child = Msg::TripUpdate; nested = true; }
+      else if (field_ == 5 && alertsMode_) { child = Msg::Alert; nested = true; }
+      break;
+    case Msg::Alert:
+      if (field_ == 1) { child = Msg::Period; nested = true; }
+      else if (field_ == 5) { child = Msg::Informed; nested = true; }
+      else if (field_ == 1001) { child = Msg::Mercury; nested = true; }
+      break;
+    case Msg::Informed:
+      if (field_ == 2) str = &informedRoute_;
+      break;
+    case Msg::Mercury:
+      if (field_ == 3) str = &alertType_;
+      break;
+    case Msg::TripUpdate:
+      if (field_ == 1) { child = Msg::Trip; nested = true; }
+      else if (field_ == 2) { child = Msg::StopTime; nested = true; }
+      break;
+    case Msg::Trip:
+      if (field_ == 5) str = &tripRoute_;
+      break;
+    case Msg::StopTime:
+      if (field_ == 2) { child = Msg::Arrival; nested = true; }
+      else if (field_ == 3) { child = Msg::Departure; nested = true; }
+      else if (field_ == 4) str = &stuStop_;
+      break;
+    default:
+      break;
+  }
+
+  if (nested) {
+    if (depth_ >= kMaxDepth) return fail(DecodeError::LengthOverrun);
+    stack_[depth_++] = Frame{child, pos_ + len};
+    openMsg(child);
+    st_ = St::Tag;
+    return fieldDone();  // an empty message closes at once
+  }
+  if (str) {
+    str->clear();
+    str->set = true;
+    target_ = str;
+  }
+  if (len == 0) {
+    target_ = nullptr;
+    st_ = St::Tag;
+    return fieldDone();
+  }
+  remain_ = len;
+  st_ = str ? St::String : St::Skip;
+  return true;
+}
+
+void GtfsRtDecoder::openMsg(Msg m) {
+  switch (m) {
+    case Msg::Entity:
+      ++entities_;
+      entDeleted_ = false;
+      entHasTrip_ = false;
+      pendTrip_ = false;
+      pendCount_ = 0;
+      pendAlert_ = 0;
+      break;
+    case Msg::Alert:
+      ++alerts_;
+      alHasPeriod_ = false;
+      alActive_ = false;
+      alMask_ = 0;
+      alertType_.clear();
+      break;
+    case Msg::Period:
+      perStart_ = 0;
+      perEnd_ = 0;
+      break;
+    case Msg::Informed:
+      informedRoute_.clear();
+      break;
+    case Msg::TripUpdate:
+      ++tripUpdates_;
+      tuRouteMatch_ = false;
+      tuCancelled_ = false;
+      tuCount_ = 0;
+      break;
+    case Msg::Trip:
+      tripRoute_.clear();
+      tripRel_ = 0;
+      break;
+    case Msg::StopTime:
+      stuStop_.clear();
+      stuRel_ = 0;
+      stuArr_ = 0;
+      stuDep_ = 0;
+      break;
+    case Msg::Arrival:
+    case Msg::Departure:
+      evTime_ = 0;
+      break;
+    default:
+      break;
+  }
+}
+
+void GtfsRtDecoder::closeMsg(Msg m) {
+  switch (m) {
+    case Msg::Arrival:
+      stuArr_ = evTime_;
+      break;
+    case Msg::Departure:
+      stuDep_ = evTime_;
+      break;
+    case Msg::StopTime: {
+      if (!stuStop_.equals(stop_)) break;
+      ++stopVisits_;
+      if (stuRel_ == kStopSkipped) break;
+      // Arrival is what a rider waits for; the departure stands in when a feed leaves it out.
+      const int64_t t = stuArr_ > 0 ? stuArr_ : stuDep_;
+      if (t > 0 && tuCount_ < kMaxTripStops) tuTimes_[tuCount_++] = t;
+      break;
+    }
+    case Msg::Trip:
+      if (tripRoute_.equals(route_)) tuRouteMatch_ = true;
+      if (tripRel_ == kTripCanceled || tripRel_ == kTripDeleted) tuCancelled_ = true;
+      break;
+    case Msg::TripUpdate:
+      if (tuRouteMatch_) ++routeTrips_;
+      if (tuRouteMatch_ && !tuCancelled_) {
+        entHasTrip_ = true;
+        for (uint8_t k = 0; k < tuCount_ && pendCount_ < kMaxTripStops; ++k)
+          pendTimes_[pendCount_++] = tuTimes_[k];
+        pendTrip_ = pendCount_ > 0;
+      }
+      break;
+    case Msg::Entity:
+      if (!entDeleted_ && pendTrip_)
+        for (uint8_t k = 0; k < pendCount_; ++k) addTime(pendTimes_[k]);
+      if (!entDeleted_) alertMask_ |= pendAlert_;
+      break;
+    case Msg::Period: {
+      alHasPeriod_ = true;
+      const uint64_t now = now_ > 0 ? static_cast<uint64_t>(now_) : 0;
+      if ((perStart_ == 0 || perStart_ <= now) && (perEnd_ == 0 || now < perEnd_)) alActive_ = true;
+      break;
+    }
+    case Msg::Informed:
+      for (int i = 0; i < nAlertRoutes_; ++i)
+        if (informedRoute_.equals(alertRoutes_[i])) alMask_ |= static_cast<uint8_t>(1u << i);
+      break;
+    case Msg::Alert:
+      // An alert with no active period is in effect for as long as it is in the feed.
+      if (alMask_ && (!alHasPeriod_ || alActive_) && isDisruption(alertType_.set ? alertType_.buf : nullptr))
+        pendAlert_ |= alMask_;
+      break;
+    default:
+      break;
+  }
+}
+
+void GtfsRtDecoder::addTime(int64_t t) {
+  if (t <= 0 || t < cutoff_) return;
+  std::size_t i = 0;
+  while (i < count_ && times_[i] < t) ++i;
+  if (i < count_ && times_[i] == t) return;  // the same arrival twice
+  if (i >= kMaxArrivals) return;
+  const std::size_t last = count_ < kMaxArrivals ? count_ : kMaxArrivals - 1;
+  for (std::size_t k = last; k > i; --k) times_[k] = times_[k - 1];
+  times_[i] = t;
+  if (count_ < kMaxArrivals) ++count_;
+}
+
+bool GtfsRtDecoder::finish() {
+  if (error_ != DecodeError::None) return false;
+  if (st_ != St::Tag || shift_ != 0 || depth_ != 1) return fail(DecodeError::Truncated);
+  return true;
+}
+
+}  // namespace awtrix::transit
