+static void test_gzip_rejects_damage() {
+  const Bytes gz = readFile("test/fixtures/mta_bdfm_20261110.pb.gz");
+  auto run = [](Bytes b, std::size_t keep) {
+    ZlibInflater z;
+    GtfsRtDecoder d;
+    d.begin("B", "A21S", 0, 0);
+    Gunzip g(z, &toDecoder, &d);
+    g.feed(reinterpret_cast<const uint8_t*>(b.data()), std::min(keep, b.size()));
+    return g.done();
+  };
+  TEST_ASSERT_TRUE(run(gz, gz.size()));
+  TEST_ASSERT_FALSE(run(gz, gz.size() - 1));       // trailer cut short
+  TEST_ASSERT_FALSE(run(gz, gz.size() / 2));       // body cut short
+  Bytes crc = gz; crc[crc.size() - 6] ^= 0x01;     // CRC-32 off by a bit
+  TEST_ASSERT_FALSE(run(crc, crc.size()));
+  Bytes len = gz; len[len.size() - 1] ^= 0x01;     // ISIZE wrong
+  TEST_ASSERT_FALSE(run(len, len.size()));
+  Bytes magic = gz; magic[0] = 0x1e;               // not gzip
+  TEST_ASSERT_FALSE(run(magic, magic.size()));
+  Bytes body = gz; body[body.size() / 2] ^= 0x5a;  // damaged DEFLATE data
+  TEST_ASSERT_FALSE(run(body, body.size()));
+  // the CRC itself, against zlib
+  const char* s = "123456789";
+  TEST_ASSERT_EQUAL_HEX32(0xCBF43926u, ~Gunzip::crc32Update(0xFFFFFFFFu, reinterpret_cast<const uint8_t*>(s), 9));
+}
