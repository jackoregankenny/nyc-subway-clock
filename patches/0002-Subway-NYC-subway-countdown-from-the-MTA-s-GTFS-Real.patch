+// ---------------------------------------------------------------- gzip
+// zlib as the raw DEFLATE decoder (the device uses the ESP32 ROM's tinfl behind the same interface).
+class ZlibInflater : public Inflater {
+ public:
+  ZlibInflater() { inflateInit2(&z_, -15); }
+  ~ZlibInflater() override { inflateEnd(&z_); }
+  Result step(const uint8_t* in, std::size_t len, std::size_t& used, Out out, void* ctx) override {
+    z_.next_in = const_cast<Bytef*>(in);
+    z_.avail_in = static_cast<uInt>(len);
+    for (;;) {
+      uint8_t buf[700];
+      z_.next_out = buf;
+      z_.avail_out = sizeof buf;
+      const int r = inflate(&z_, Z_NO_FLUSH);
+      const std::size_t got = sizeof buf - z_.avail_out;
+      if (got && !out(ctx, buf, got)) return Result::Error;
+      used = len - z_.avail_in;
+      if (r == Z_STREAM_END) return Result::Done;
+      if (r != Z_OK && r != Z_BUF_ERROR) return Result::Error;
+      if (z_.avail_in == 0 && z_.avail_out != 0) return Result::More;
+    }
+  }
+
+ private:
+  z_stream z_{};
+};
+
+// Like the ESP32's ROM tinfl: after the end of the DEFLATE data it has already swallowed up to
+// `ahead` bytes of what follows (the gzip trailer) and does not give them back.
+class ReadAheadInflater : public ZlibInflater {
+ public:
+  explicit ReadAheadInflater(std::size_t ahead) : ahead_(ahead) {}
+  Result step(const uint8_t* in, std::size_t len, std::size_t& used, Out out, void* ctx) override {
+    const Result r = ZlibInflater::step(in, len, used, out, ctx);
+    if (r == Result::Done) used = std::min(len, used + ahead_);
+    return r;
+  }
+
+ private:
+  std::size_t ahead_;
+};
+
+static Bytes readFile(const char* path) {
+  std::ifstream in(path, std::ios::binary);
+  return Bytes((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+}
