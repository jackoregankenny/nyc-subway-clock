+static void test_gzip_feed_decodes_like_the_plain_one() {
+  // The saved bdfm snapshot gzipped by Python (with a file name in the header): through Gunzip the
+  // decoder must see exactly the plain bytes, in any chunking.
+  const Bytes plain = readFile("test/fixtures/mta_bdfm_20261110.pb");
+  const Bytes gz = readFile("test/fixtures/mta_bdfm_20261110.pb.gz");
+  TEST_ASSERT_TRUE(gz.size() > 1000 && gz.size() < plain.size() / 3);
+  const GtfsRtDecoder ref = decodeAll(plain, 4096);
+  for (std::size_t chunk : {1u, 3u, 10u, 11u, 512u, 1460u, 100000u}) {
+    ZlibInflater z;
+    GtfsRtDecoder d;
+    d.begin("B", "A21S", 0, 0);
+    Gunzip g(z, &toDecoder, &d);
+    for (std::size_t i = 0; i < gz.size(); i += chunk)
+      TEST_ASSERT_TRUE_MESSAGE(g.feed(reinterpret_cast<const uint8_t*>(gz.data()) + i, std::min(chunk, gz.size() - i)),
+                               g.error());
+    TEST_ASSERT_TRUE_MESSAGE(g.done(), g.error());
+    TEST_ASSERT_TRUE(d.finish());
+    TEST_ASSERT_EQUAL_UINT32(plain.size(), g.outBytes());
+    TEST_ASSERT_EQUAL_UINT64(ref.headerTimestamp(), d.headerTimestamp());
+    TEST_ASSERT_EQUAL(ref.count(), d.count());
+    for (std::size_t i = 0; i < ref.count(); ++i) TEST_ASSERT_EQUAL_INT64(ref.at(i), d.at(i));
+  }
+}
