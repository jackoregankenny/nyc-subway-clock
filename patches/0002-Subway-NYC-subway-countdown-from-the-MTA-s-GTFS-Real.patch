+static Canvas renderView(const BoardView& v, const char* route = "B") {
+  Canvas c(32, 8);
+  c.clear();
+  renderSubway(c, awtrixFont(), v, SubwayStyle::forRoute(route));
+  return c;
+}
+
+static bool columnLit(const Canvas& c, int x) {
+  for (int y = 0; y < c.height(); ++y)
+    if (c.getPixel(x, y)) return true;
+  return false;
+}
+
+static BoardView live(int a, int b = -1) {
+  BoardView v;
+  v.state = BoardState::Live;
+  v.minutes[0] = a;
+  v.minutes[1] = b;
+  v.trains = b >= 0 ? 2 : 1;
+  return v;
+}
