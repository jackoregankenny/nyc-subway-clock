+static void test_gzip_survives_a_decoder_that_reads_ahead() {
+  // On the clock, ace and alerts downloads arrived whole but failed as "cut off": the ROM decoder
+  // had eaten part of the trailer. Any read-ahead, any chunking, must still check out.
+  const Bytes plain = readFile("test/fixtures/mta_bdfm_20261110.pb");
+  const Bytes gz = readFile("test/fixtures/mta_bdfm_20261110.pb.gz");
+  for (std::size_t ahead : {1u, 2u, 3u, 4u})
+    for (std::size_t chunk : {1u, 5u, 1460u, 100000u}) {
+      ReadAheadInflater z(ahead);
+      GtfsRtDecoder d;
+      d.begin("B", "A21S", 0, 0);
+      Gunzip g(z, &toDecoder, &d);
+      for (std::size_t i = 0; i < gz.size(); i += chunk)
+        g.feed(reinterpret_cast<const uint8_t*>(gz.data()) + i, std::min(chunk, gz.size() - i));
+      TEST_ASSERT_TRUE_MESSAGE(g.done(), g.error());
+      TEST_ASSERT_EQUAL_UINT32(plain.size(), g.outBytes());
+      Bytes bad = gz; bad[bad.size() - 6] ^= 0x01;  // and a wrong CRC is still caught
+      ReadAheadInflater z2(ahead);
+      GtfsRtDecoder d2;
+      d2.begin("B", "A21S", 0, 0);
+      Gunzip g2(z2, &toDecoder, &d2);
+      g2.feed(reinterpret_cast<const uint8_t*>(bad.data()), bad.size());
+      TEST_ASSERT_FALSE(g2.done());
+      TEST_ASSERT_TRUE(*g2.error() != 0);
+    }
+}
