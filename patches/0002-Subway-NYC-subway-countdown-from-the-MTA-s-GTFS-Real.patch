@@ -0,0 +1,623 @@
+// B-train gift clock addition (not upstream AWTRIX NG). See MtaFeedService.h.
+
+#include "system/MtaFeedService.h"
+
+#include <Arduino.h>
+#include <HTTPClient.h>
+#include <WiFi.h>
+#include <WiFiClientSecure.h>
+#include <esp_heap_caps.h>
+
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+
+#include "berry.h"
+#include "core/apps/IApp.h"
+#include "core/script/BerryVM.h"
+#include "core/script/ScriptBindings.h"
+#include "core/script/ScriptHost.h"
+#include "core/script/ScriptServices.h"
+#include "core/transit/GtfsRtDecoder.h"
+#include "core/transit/Routes.h"
+#include "core/transit/SubwayView.h"
+#include "system/HeapCaps.h"
+#include "system/Log.h"
+#include "system/MonotonicClock.h"
+#include "system/MtaRoots.h"
+#include "system/RomInflater.h"
+#include "core/transit/Gunzip.h"
+
+namespace awtrix {
+
+namespace {
+
+constexpr UBaseType_t kPriority = 1;
+constexpr BaseType_t kCore = 0;
+constexpr int64_t kClockValidAfter = 1700000000;  // 2023-11: before that, SNTP has not answered
+
+int64_t epochNow() {
+  const time_t t = time(nullptr);
+  return t > kClockValidAfter ? static_cast<int64_t>(t) : -1;
+}
+
+void copyField(char* dst, std::size_t cap, const char* src) {
+  if (!src) src = "";
+  std::size_t n = std::strlen(src);
+  if (n >= cap) n = cap - 1;
+  std::memcpy(dst, src, n);
+  dst[n] = 0;
+}
+
+// Bounds the whole request, not just each socket read.
+struct Deadline {
+  int64_t atMs;
+  bool reached() const { return monotonicMs() >= atMs; }
+};
+
+class DeadlineTls : public WiFiClientSecure {
+ public:
+  explicit DeadlineTls(const Deadline& d) : d_(d) {}
+  uint8_t connected() override { return d_.reached() ? 0 : WiFiClientSecure::connected(); }
+  int available() override { return d_.reached() ? 0 : WiFiClientSecure::available(); }
+
+ private:
+  const Deadline& d_;
+};
+
+// Hands each piece of the response to every decoder (one per route read from this feed).
+class DecoderSink : public Stream {
+ public:
+  DecoderSink(transit::GtfsRtDecoder* d, int n) : d_(d), n_(n) {}
+  size_t write(uint8_t b) override { return write(&b, 1); }
+  size_t write(const uint8_t* data, size_t len) override {
+    bool ok = true;
+    for (int i = 0; i < n_; ++i) ok = d_[i].feed(data, len) && ok;
+    return ok ? len : 0;
+  }
+  int available() override { return 0; }
+  int read() override { return -1; }
+  int peek() override { return -1; }
+  void flush() override {}
+
+ private:
+  transit::GtfsRtDecoder* d_;
+  int n_;
+};
+
+// What comes off the socket: counted, then either inflated into the decoders (gzip) or handed
+// to them as it is.
+class WireSink : public Stream {
+ public:
+  WireSink(DecoderSink& plain, transit::Gunzip* gz) : plain_(plain), gz_(gz) {}
+  size_t write(uint8_t b) override { return write(&b, 1); }
+  size_t write(const uint8_t* data, size_t len) override {
+    wire_ += len;
+    if (gz_) return gz_->feed(data, len) ? len : 0;
+    return plain_.write(data, len);
+  }
+  int available() override { return 0; }
+  int read() override { return -1; }
+  int peek() override { return -1; }
+  void flush() override {}
+  uint32_t wire() const { return wire_; }
+
+ private:
+  DecoderSink& plain_;
+  transit::Gunzip* gz_;
+  uint32_t wire_ = 0;
+};
+
+bool inflateInto(void* sink, const uint8_t* d, std::size_t n) {
+  return static_cast<DecoderSink*>(sink)->write(d, n) == n;
+}
+
+MtaFeedService* self(bvm* vm) { return static_cast<MtaFeedService*>(script::BerryVM::nativeSelf(vm)); }
+
+const char* argString(bvm* vm, int i, const char* fallback) {
+  return be_top(vm) >= i && be_isstring(vm, i) ? be_tostring(vm, i) : fallback;
+}
+int argInt(bvm* vm, int i, int fallback) {
+  return be_top(vm) >= i && be_isnumber(vm, i) ? static_cast<int>(be_toint(vm, i)) : fallback;
+}
+bool argBool(bvm* vm, int i, bool fallback) {
+  return be_top(vm) >= i && be_isbool(vm, i) ? be_tobool(vm, i) : fallback;
+}
+
+}  // namespace
+
+void MtaFeedService::installNatives(script::ScriptHost& host) {
+  host.defineNative("subway_config", &MtaFeedService::nConfig, this);
+  host.defineNative("subway_state", &MtaFeedService::nState, this);
+  host.defineNative("subway_should_show", &MtaFeedService::nShouldShow, this);
+  host.defineNative("subway_draw", &MtaFeedService::nDraw, this);
+  host.defineNative("subway_status", &MtaFeedService::nStatus, this);
+}
+
+MtaFeedService::Status MtaFeedService::status() {
+  Status out;
+  portENTER_CRITICAL(&lock_);
+  out = st_;
+  portEXIT_CRITICAL(&lock_);
+  return out;
+}
+
+void MtaFeedService::configure(const Config& c) {
+  bool changed;
+  portENTER_CRITICAL(&lock_);
+  changed = c.lines != cfg_.lines || std::strcmp(c.stop, cfg_.stop) || c.verifyTls != cfg_.verifyTls ||
+            c.alerts != cfg_.alerts;
+  for (int i = 0; i < c.lines && !changed; ++i)
+    changed = std::strcmp(c.route[i], cfg_.route[i]) || std::strcmp(c.url[i], cfg_.url[i]);
+  cfg_ = c;
+  st_.staleSec = c.staleSec;
+  if (changed) {
+    // Times for the old stop or route must not be shown as the new one's.
+    st_.lines = c.lines;
+    for (int i = 0; i < kMaxLines; ++i) {
+      st_.line[i] = Line{};
+      copyField(st_.line[i].route, sizeof st_.line[i].route, i < c.lines ? c.route[i] : "");
+    }
+    st_.alerts = Alerts{};
+    ++generation_;
+  }
+  portEXIT_CRITICAL(&lock_);
+  demand();
+  if (changed) {
+    char routes[3 * kMaxLines * 8] = "";
+    for (int i = 0; i < c.lines; ++i) {
+      if (i) std::strncat(routes, ",", sizeof routes - std::strlen(routes) - 1);
+      std::strncat(routes, c.route[i], sizeof routes - std::strlen(routes) - 1);
+    }
+    logf("subway: route %s stop %s every %d s, stale after %d s, tls %s", routes, c.stop,
+         static_cast<int>(c.intervalSec), static_cast<int>(c.staleSec), c.verifyTls ? "verified" : "UNVERIFIED");
+    nextAlertsMs_ = 0;
+    wake_.store(true);
+  }
+}
+
+void MtaFeedService::noteDisplay(const RenderCtx* ctx) {
+  if (!ctx || !ctx->runtime) return;
+  const bool dark = ctx->runtime->matrixOff || ctx->runtime->brightnessActual == 0;
+  if (asleep_.exchange(dark) != dark) {
+    logf("subway: display %s, downloads %s", dark ? "dark" : "on", dark ? "paused" : "resumed");
+    if (!dark) wake_.store(true);
+  }
+}
+
+void MtaFeedService::demand() {
+  lastDemandMs_.store(monotonicMs());
+  ensureTask();
+}
+
+bool MtaFeedService::ensureTask() {
+  if (task_) return true;
+  if (xTaskCreatePinnedToCore(taskEntry, "subway", kStackBytes, this, kPriority, &task_, kCore) != pdPASS) {
+    task_ = nullptr;
+    logf("subway: no memory for the fetch task (%u largest)",
+         static_cast<unsigned>(heap_caps_get_largest_free_block(kGuardHeapCaps)));
+    return false;
+  }
+  return true;
+}
+
+void MtaFeedService::taskEntry(void* p) { static_cast<MtaFeedService*>(p)->run(); }
+
+void MtaFeedService::run() {
+  int64_t nextAtMs = 0;
+  uint8_t tightTries = 0;
+  for (;;) {
+    vTaskDelay(pdMS_TO_TICKS(250));
+    const int64_t now = monotonicMs();
+
+    if (!WiFi.isConnected()) {
+      connectedAtMs_ = -1;
+      continue;
+    }
+    if (connectedAtMs_ < 0) connectedAtMs_ = now;
+    // Same grace the script HTTP worker gives a fresh join: the Wi-Fi stack still holds buffers.
+    if (script::tlsBootGraceActive(now - connectedAtMs_)) continue;
+    if (epochNow() < 0) continue;  // TLS validity and countdowns both need the real time
+
+    const int64_t demandMs = lastDemandMs_.load();
+    if (demandMs < 0 || now - demandMs > kIdleAfterMs) continue;
+    if (asleep_.load()) continue;
+
+    if (wake_.exchange(false)) nextAtMs = 0;
+    if (now < nextAtMs) continue;
+
+    const std::size_t freeHeap = heap_caps_get_free_size(kGuardHeapCaps);
+    const std::size_t largest = heap_caps_get_largest_free_block(kGuardHeapCaps);
+    if (!script::fetchFits(true, freeHeap, largest) && tightTries < script::kMaxTightRetries) {
+      ++tightTries;
+      nextAtMs = now + script::kTightRetryDelayMs;
+      continue;
+    }
+    tightTries = 0;
+
+    Config cfg;
+    portENTER_CRITICAL(&lock_);
+    cfg = cfg_;
+    portEXIT_CRITICAL(&lock_);
+
+    fetchOnce(cfg);
+    if (cfg.alerts && !asleep_.load() && monotonicMs() >= nextAlertsMs_) {
+      const std::size_t f = heap_caps_get_free_size(kGuardHeapCaps);
+      const std::size_t l = heap_caps_get_largest_free_block(kGuardHeapCaps);
+      if (script::fetchFits(true, f, l)) {
+        fetchAlerts(cfg);
+        nextAlertsMs_ = monotonicMs() + kAlertsEveryMs;
+      }
+    }
+
+    uint32_t failures = 0;
+    portENTER_CRITICAL(&lock_);
+    for (int i = 0; i < st_.lines; ++i)
+      if (st_.line[i].snap.failures > failures) failures = st_.line[i].snap.failures;
+    portEXIT_CRITICAL(&lock_);
+    nextAtMs = monotonicMs() + transit::nextDelayMs(failures, int64_t{cfg.intervalSec} * 1000);
+  }
+}
+
+// Runs on the fetch task. One request per distinct feed URL; routes that share a feed are decoded
+// from the same bytes.
+void MtaFeedService::fetchOnce(const Config& cfg) {
+  bool done[kMaxLines] = {};
+  for (int i = 0; i < cfg.lines; ++i) {
+    if (done[i]) continue;
+    int idx[kMaxLines];
+    int n = 0;
+    for (int j = i; j < cfg.lines; ++j)
+      if (!done[j] && std::strcmp(cfg.url[j], cfg.url[i]) == 0) {
+        idx[n++] = j;
+        done[j] = true;
+      }
+    fetchFeed(cfg, idx, n);
+  }
+}
+
+// The TLS client is stack-local, so the session's memory is handed back as soon as this returns:
+// nothing grows over a long uptime. All decoders see the same bytes, so wire errors are shared.
+bool MtaFeedService::download(const Config& cfg, const char* url, transit::GtfsRtDecoder* decoders, int n,
+                              int& code, char* err, std::size_t errCap, uint32_t& wireBytes) {
+  transit::GtfsRtDecoder& decoder = decoders[0];
+  const Deadline end{monotonicMs() + kRequestBudgetMs};
+  DeadlineTls tls(end);
+  if (cfg.verifyTls) tls.setCACert(kMtaRootsPem);
+  else tls.setInsecure();  // only when the user switched verification off in the app's settings
+  tls.setTimeout(10);
+
+  HTTPClient http;
+  http.setConnectTimeout(8000);
+  http.setTimeout(10000);
+  http.setReuse(false);
+  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
+
+  code = 0;
+  bool ok = false;
+  err[0] = 0;
+  if (!http.begin(tls, url)) {
+    std::snprintf(err, errCap, "bad url");
+    return false;
+  }
+
+  // Gzip is about 5x less to download; it needs RomInflater::kNeedBytes while the body streams, so
+  // it is only asked for when that leaves room for TLS. Three gzip failures in a row: plain from then on.
+  const bool askGzip = gzipOk_ && heap_caps_get_largest_free_block(kGuardHeapCaps) >= RomInflater::kNeedBytes + 16384 &&
+                       heap_caps_get_free_size(kGuardHeapCaps) >= RomInflater::kNeedBytes + 40960;
+  // HTTPClient (HTTP/1.1 mode) always writes its own "Accept-Encoding: identity;q=1,...,*;q=0" line,
+  // and the MTA's server goes by the first Accept-Encoding line it sees (checked with curl
+  // --http1.1, 2026-11-12). The User-Agent line is written before it, so ours rides along there.
+  // (HTTP/1.0 mode would drop the library's line, but the MTA does not gzip HTTP/1.0 requests.)
+  http.setUserAgent(askGzip ? "AWTRIX-NG B-train clock\r\nAccept-Encoding: gzip" : "AWTRIX-NG B-train clock");
+  static const char* kWanted[] = {"Content-Encoding"};
+  http.collectHeaders(kWanted, 1);
+  http.addHeader("Accept", "application/x-protobuf, application/octet-stream, */*");
+  code = http.GET();
+  if (code != 200) {
+    if (code < 0) std::snprintf(err, errCap, "net %s", HTTPClient::errorToString(code).c_str());
+    else std::snprintf(err, errCap, "http %d", code);
+  } else {
+    const int size = http.getSize();  // -1 when chunked
+    if (size > 0 && static_cast<uint32_t>(size) > kMaxFeedBytes) {
+      std::snprintf(err, errCap, "too large (%d B)", size);
+    } else {
+      const String encoding = http.header("Content-Encoding");
+      const bool gz = encoding.equalsIgnoreCase("gzip");
+      DecoderSink plain(decoders, n);
+      RomInflater inflater;
+      transit::Gunzip gunzip(inflater, &inflateInto, &plain);
+      if (encoding.length() && !gz && !encoding.equalsIgnoreCase("identity")) {
+        std::snprintf(err, errCap, "encoding %s", encoding.c_str());
+        http.end();
+        return false;
+      }
+      if (gz && !inflater.begin()) {
+        std::snprintf(err, errCap, "no memory for gzip");
+        if (++gzipFailures_ >= 3) gzipOk_ = false;
+        http.end();
+        return false;
+      }
+      WireSink sink(plain, gz ? &gunzip : nullptr);
+      const int written = http.writeToStream(&sink);
+      wireBytes = sink.wire();
+      const bool complete = written >= 0 && (size <= 0 || sink.wire() == static_cast<uint32_t>(size)) &&
+                            (!gz || gunzip.done());
+      bool finished = true;
+      if (complete && decoder.error() == transit::DecodeError::None && !end.reached())
+        for (int k = 0; k < n; ++k) finished = decoders[k].finish() && finished;
+      if (end.reached()) std::snprintf(err, errCap, "timeout after %u B", static_cast<unsigned>(sink.wire()));
+      else if (gz && *gunzip.error()) {
+        std::snprintf(err, errCap, "gzip: %s", gunzip.error());
+        if (++gzipFailures_ >= 3) {
+          gzipOk_ = false;
+          logf("subway: gzip failed 3 times, plain downloads from now on");
+        }
+      } else if (decoder.error() != transit::DecodeError::None)
+        std::snprintf(err, errCap, "parse: %s", transit::decodeErrorName(decoder.error()));
+      else if (!complete) std::snprintf(err, errCap, "cut off at %u B", static_cast<unsigned>(sink.wire()));
+      else if (!finished) std::snprintf(err, errCap, "parse: %s", transit::decodeErrorName(decoder.error()));
+      else if (decoder.headerTimestamp() == 0) std::snprintf(err, errCap, "no feed timestamp");
+      else ok = true;
+      if (ok && gz) gzipFailures_ = 0;
+      lastGzip_ = gz;
+    }
+  }
+  http.end();
+  return ok;
+}
+
+void MtaFeedService::fetchFeed(const Config& cfg, const int* lines, int n) {
+  uint32_t gen;
+  portENTER_CRITICAL(&lock_);
+  gen = generation_;
+  portEXIT_CRITICAL(&lock_);
+
+  const int64_t t0 = monotonicMs();
+  const int64_t nowEpoch = epochNow();
+  transit::GtfsRtDecoder decoders[kMaxLines];
+  // Keep times from a little in the past: the board still shows a train for kGraceSec after its time.
+  for (int k = 0; k < n; ++k) decoders[k].begin(cfg.route[lines[k]], cfg.stop, nowEpoch - 120, kMaxFeedBytes);
+  const transit::GtfsRtDecoder& decoder = decoders[0];
+  int code = 0;
+  char err[40];
+  uint32_t wire = 0;
+  const bool ok = download(cfg, cfg.url[lines[0]], decoders, n, code, err, sizeof err, wire);
+  const uint32_t ms = static_cast<uint32_t>(monotonicMs() - t0);
+
+  portENTER_CRITICAL(&lock_);
+  if (gen == generation_) {
+    for (int k = 0; k < n; ++k) {
+      Line& line = st_.line[lines[k]];
+      const transit::GtfsRtDecoder& d = decoders[k];
+      transit::FeedSnapshot& s = line.snap;
+      s.everFinished = true;
+      s.lastOk = ok;
+      if (ok) {
+        s.failures = 0;
+        s.feedTimestamp = static_cast<int64_t>(d.headerTimestamp());
+        s.receivedEpoch = nowEpoch;
+        s.count = 0;
+        for (std::size_t i = 0; i < d.count() && s.count < transit::FeedSnapshot::kMax; ++i)
+          s.times[s.count++] = d.at(i);
+        line.routeTrips = d.routeTrips();
+        line.stopVisits = d.stopVisits();
+      } else if (s.failures < UINT32_MAX) {
+        ++s.failures;
+      }
+      line.lastHttp = code;
+      line.lastBytes = wire;
+      line.lastMs = ms;
+      copyField(line.lastError, sizeof line.lastError, err);
+    }
+  }
+  portEXIT_CRITICAL(&lock_);
+
+  if (ok)
+    // No 64-bit (ll) printf conversions: the firmware links newlib's nano printf (scripts/newlib_nano.py), which
+    // does not handle 64-bit arguments and then misreads every argument after one.
+    logdbg("subway: %u B (%u B unpacked) in %u ms, %u entities, %u %s at %s, feed %ld s old", static_cast<unsigned>(wire),
+           static_cast<unsigned>(decoder.bytes()), static_cast<unsigned>(ms), static_cast<unsigned>(decoder.entities()),
+           static_cast<unsigned>(decoder.count()), cfg.route[lines[0]], cfg.stop,
+           static_cast<long>(nowEpoch - static_cast<int64_t>(decoder.headerTimestamp())));
+  else
+    logf("subway: fetch failed (%s) after %u ms", err, static_cast<unsigned>(ms));
+}
+
+// The MTA's subway alerts (about 0.5 MB), every kAlertsEveryMs: only whether a disruption is in
+// effect on one of the lines is kept.
+void MtaFeedService::fetchAlerts(const Config& cfg) {
+  uint32_t gen;
+  portENTER_CRITICAL(&lock_);
+  gen = generation_;
+  portEXIT_CRITICAL(&lock_);
+
+  const int64_t t0 = monotonicMs();
+  const int64_t nowEpoch = epochNow();
+  const char* routes[kMaxLines];
+  for (int i = 0; i < cfg.lines; ++i) routes[i] = cfg.route[i];
+  transit::GtfsRtDecoder decoder;
+  decoder.beginAlerts(routes, cfg.lines, nowEpoch, kMaxFeedBytes);
+  int code = 0;
+  char err[40];
+  uint32_t wire = 0;
+  const bool ok = download(cfg, transit::kMtaAlertsUrl, &decoder, 1, code, err, sizeof err, wire);
+  const uint32_t ms = static_cast<uint32_t>(monotonicMs() - t0);
+
+  uint8_t was = 0;
+  portENTER_CRITICAL(&lock_);
+  Alerts& a = st_.alerts;
+  was = a.mask;
+  if (gen == generation_) {
+    if (ok) {
+      a.mask = decoder.alertMask();
+      a.okEpoch = nowEpoch;
+      a.failures = 0;
+    } else if (a.failures < UINT32_MAX) {
+      ++a.failures;
+    }
+    a.lastBytes = wire;
+    a.lastMs = ms;
+    copyField(a.lastError, sizeof a.lastError, err);
+  }
+  portEXIT_CRITICAL(&lock_);
+
+  if (!ok) {
+    logf("subway: alerts fetch failed (%s) after %u ms", err, static_cast<unsigned>(ms));
+  } else if (decoder.alertMask() != was) {
+    char names[24] = "";
+    for (int i = 0; i < cfg.lines; ++i)
+      if (decoder.alertMask() & (1u << i)) {
+        const std::size_t n = std::strlen(names);
+        std::snprintf(names + n, sizeof names - n, "%s%s", n ? "," : "", cfg.route[i]);
+      }
+    logf("subway: MTA alerts: %s%s (%u alerts, %u B%s in %u ms)", names[0] ? "disruption on " : "clear", names,
+         static_cast<unsigned>(decoder.alerts()), static_cast<unsigned>(wire), lastGzip_ ? " gzip" : "",
+         static_cast<unsigned>(ms));
+  }
+}
+
+bool MtaFeedService::alertShown(const Status& s, int64_t nowEpochSec) const {
+  return s.alerts.mask && nowEpochSec > 0 && s.alerts.okEpoch > 0 && nowEpochSec - s.alerts.okEpoch <= kAlertsValidSec;
+}
+
+int MtaFeedService::views(int64_t nowEpochSec, transit::BoardView* out) {
+  const Status s = status();
+  for (int i = 0; i < s.lines; ++i) out[i] = transit::viewAt(s.line[i].snap, nowEpochSec, s.staleSec);
+  return s.lines;
+}
+
+// subway_config(route, station, direction, feed_url, every_s, stale_s, verify, layout, alerts)
+//   route      one or two NYC subway route ids, "B" or "B,C" ("6X", "gs" too); upper-cased
+//   station    GTFS station id ("A21"), or a full stop id with its direction ("A21S")
+//   direction  "N" or "S"; ignored when the station already ends in one
+//   feed_url   "" picks the MTA feed that carries each route (core/transit/Routes.h); a URL here is
+//              used for every route
+//   layout     with two routes: "numbers", "bullets" or "turns" (core/transit/SubwayView.h)
+//   alerts     true: a red dot while the MTA reports a disruption on one of the routes
+int MtaFeedService::nConfig(bvm* vm) {
+  MtaFeedService* me = self(vm);
+  Config c;
+  std::string routes[kMaxLines];
+  c.lines = transit::parseRoutes(argString(vm, 1, "B"), routes, kMaxLines);
+  if (c.lines == 0) {
+    routes[0] = "B";
+    c.lines = 1;
+  }
+  const char* dir = argString(vm, 3, "S");
+  const std::string stop = transit::stopIdFor(argString(vm, 2, "A21"), dir[0]);
+  copyField(c.stop, sizeof c.stop, stop.empty() ? "A21S" : stop.c_str());
+  const char* url = argString(vm, 4, "");
+  const bool custom = std::strncmp(url, "https://", 8) == 0 || std::strncmp(url, "http://", 7) == 0;
+  const std::string fallback = transit::feedUrlFor("B");
+  for (int i = 0; i < c.lines; ++i) {
+    copyField(c.route[i], sizeof c.route[i], routes[i].c_str());
+    const std::string automatic = transit::feedUrlFor(c.route[i]);
+    // An unknown route and no URL gets the default feed; the status line says the route is not in it.
+    copyField(c.url[i], sizeof c.url[i], custom ? url : !automatic.empty() ? automatic.c_str() : fallback.c_str());
+  }
+  int every = argInt(vm, 5, c.intervalSec);
+  int stale = argInt(vm, 6, c.staleSec);
+  c.intervalSec = every < 20 ? 20 : every > 600 ? 600 : every;
+  c.staleSec = stale < 60 ? 60 : stale > 1800 ? 1800 : stale;
+  c.verifyTls = argBool(vm, 7, true);
+  c.layout = transit::layoutFromName(argString(vm, 8, "numbers"));
+  c.alerts = argBool(vm, 9, true);
+  if (me) me->configure(c);
+  be_pushbool(vm, me != nullptr);
+  be_return(vm);
+}
+
+// subway_state() -> "live", "no_arrivals", "stale", "unavailable", "loading" or "no_clock";
+// with two routes, live when either is
+int MtaFeedService::nState(bvm* vm) {
+  MtaFeedService* me = self(vm);
+  if (!me) be_return_nil(vm);
+  me->demand();
+  me->noteDisplay(script::BindingScope::currentContext());
+  transit::BoardView v[kMaxLines];
+  const int n = me->views(epochNow(), v);
+  be_pushstring(vm, transit::boardStateName(transit::combinedState(v, n)));
+  be_return(vm);
+}
+
+// subway_should_show(show_offline) -> a turn only when there is something true to say
+int MtaFeedService::nShouldShow(bvm* vm) {
+  MtaFeedService* me = self(vm);
+  bool show = false;
+  if (me) {
+    me->demand();
+    me->noteDisplay(script::BindingScope::currentContext());
+    transit::BoardView v[kMaxLines];
+    const transit::BoardState st = transit::combinedState(v, me->views(epochNow(), v));
+    show = st == transit::BoardState::Live ||
+           (argBool(vm, 1, true) && (st == transit::BoardState::Stale || st == transit::BoardState::Unavailable));
+  }
+  be_pushbool(vm, show);
+  be_return(vm);
+}
+
+// subway_draw() -- only inside draw(); bullets and colors come from the configured routes. The
+// argument older scripts pass (the route) is ignored.
+int MtaFeedService::nDraw(bvm* vm) {
+  MtaFeedService* me = self(vm);
+  Canvas* canvas = script::BindingScope::currentCanvas();
+  const RenderCtx* ctx = script::BindingScope::currentContext();
+  if (!me || !canvas || !ctx || !ctx->font) {
+    be_pushbool(vm, false);
+    be_return(vm);
+  }
+  const int64_t nowEpoch = ctx->epochMs >= 0 ? ctx->epochMs / 1000 : -1;
+  const Status s = me->status();
+  transit::Layout layout;
+  portENTER_CRITICAL(&me->lock_);
+  layout = me->cfg_.layout;
+  portEXIT_CRITICAL(&me->lock_);
+  transit::BoardView v[kMaxLines];
+  transit::SubwayStyle style[kMaxLines];
+  for (int i = 0; i < s.lines; ++i) {
+    v[i] = transit::viewAt(s.line[i].snap, nowEpoch > kClockValidAfter ? nowEpoch : -1, s.staleSec);
+    style[i] = transit::SubwayStyle::forRoute(s.line[i].route);
+    if (ctx->settings) style[i].text = ctx->settings->textColor;
+  }
+  transit::renderBoard(*canvas, *ctx->font, v, style, s.lines, layout, monotonicMs());
+  if (me->alertShown(s, nowEpoch > kClockValidAfter ? nowEpoch : -1)) transit::drawAlertDot(*canvas);
+  be_pushbool(vm, true);
+  be_return(vm);
+}
+
+// subway_status() -> one line for the log: per route, state, countdowns and the last attempt
+int MtaFeedService::nStatus(bvm* vm) {
+  MtaFeedService* me = self(vm);
+  if (!me) be_return_nil(vm);
+  const Status s = me->status();
+  const int64_t now = epochNow();
+  char stop[16];
+  portENTER_CRITICAL(&me->lock_);
+  copyField(stop, sizeof stop, me->cfg_.stop);
+  portEXIT_CRITICAL(&me->lock_);
+  char line[480];
+  int len = 0;
+  for (int i = 0; i < s.lines && len < static_cast<int>(sizeof line); ++i) {
+    const Line& l = s.line[i];
+    const transit::BoardView v = transit::viewAt(l.snap, now, s.staleSec);
+    // A fresh feed with nothing for this route or stop at all means a typo or the wrong feed, not a
+    // quiet night: say so instead of a bare no_arrivals.
+    const char* hint = "";
+    if (l.snap.lastOk && l.routeTrips == 0) hint = " (route not in this feed)";
+    else if (l.snap.lastOk && l.stopVisits == 0) hint = " (stop not in this feed)";
+    // long, not long long: see the note in fetchFeed() about nano printf.
+    len += std::snprintf(line + len, sizeof line - len, "%s%s %s %s%s %d %d | feed age %lds | last %s%s %uB %ums",
+                         i ? " || " : "", l.route, stop, transit::boardStateName(v.state), hint, v.minutes[0],
+                         v.minutes[1], static_cast<long>(l.snap.feedTimestamp && now > 0 ? now - l.snap.feedTimestamp : -1),
+                         l.snap.lastOk ? "ok" : "fail ", l.snap.lastOk ? "" : l.lastError,
+                         static_cast<unsigned>(l.lastBytes), static_cast<unsigned>(l.lastMs));
+  }
+  if (len < static_cast<int>(sizeof line))
+    std::snprintf(line + len, sizeof line - len, " || alerts %s", s.alerts.okEpoch == 0 ? (s.alerts.failures ? s.alerts.lastError : "-")
+                                                              : me->alertShown(s, now) ? "DISRUPTION" : "clear");
+  be_pushstring(vm, line);
+  be_return(vm);
+}
+
