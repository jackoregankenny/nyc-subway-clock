+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// Fetches the official MTA GTFS-Realtime feed over HTTPS on its own FreeRTOS task and decodes it
+// as it streams in (core/transit/GtfsRtDecoder), so the LED loop, buttons, Wi-Fi and the web UI
+// never wait on it. The display side only copies a ~100-byte snapshot under a spinlock.
+//
+// The task exists from the first subway_config() call on, so a clock without the Subway app pays
+// nothing; it stops fetching when no script has asked for arrivals for five minutes (the app was
+// removed or switched off) and resumes on the next call. It also pauses while the display is dark
+// (the room's light is under "Off when dark", or the display was switched off). One request at a time, 30 s apart by
+// default, with exponential backoff to 5 minutes after failures.
+//
+// Up to three routes at the same station (B, C and A at 81 St): one request per feed, so routes in
+// different feeds cost a request each per round, and routes in the same feed (C and A) share one.
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <freertos/task.h>
+
+#include <atomic>
+#include <cstdint>
+
+#include "core/transit/ArrivalBoard.h"
+#include "core/transit/SubwayView.h"
+
+typedef struct bvm bvm;
+
+namespace awtrix {
+
+namespace script {
+class ScriptHost;
+}
+namespace transit {
+class GtfsRtDecoder;
+}
+struct RenderCtx;
+
+class MtaFeedService {
+ public:
+  static constexpr int kMaxLines = transit::kMaxLines;  // routes on one screen (core/transit/SubwayView.h)
+
+  struct Config {
+    int lines = 1;
+    char route[kMaxLines][8] = {"B", ""};
+    char url[kMaxLines][256] = {"https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-bdfm", ""};
+    char stop[16] = "A21S";
+    int32_t intervalSec = 30;
+    int32_t staleSec = 120;
+    bool verifyTls = true;
+    transit::Layout layout = transit::Layout::Numbers;
+    bool alerts = true;         // fetch the MTA alerts feed for the red dot
+  };
+
+  struct Line {
+    char route[8] = "";
+    transit::FeedSnapshot snap;
+    int lastHttp = 0;           // HTTP status of the last attempt, or a negative transport code
+    uint32_t lastBytes = 0;
+    uint32_t lastMs = 0;        // duration of the last attempt
+    uint32_t routeTrips = 0;    // trips of the route in the last good feed (0: wrong route or feed)
+    uint32_t stopVisits = 0;    // updates at the stop in the last good feed (0: wrong stop or feed)
+    char lastError[40] = "";
+  };
+
+  struct Alerts {
+    uint8_t mask = 0;           // bit i: a disruption on line i, from the last good alerts feed
+    int64_t okEpoch = 0;        // device time of the last good alerts feed, Unix seconds
+    uint32_t failures = 0;
+    uint32_t lastBytes = 0, lastMs = 0;
+    char lastError[40] = "";
+  };
+
+  struct Status {
+    int lines = 1;
+    Line line[kMaxLines];
+    Alerts alerts;
+    int32_t staleSec = 120;
+  };
+
+  // Defines the subway_* natives in the script VM. Call before scripts are restored.
+  void installNatives(script::ScriptHost& host);
+
+  Status status();
+
+ private:
+  static constexpr uint32_t kStackBytes = 11264;  // three decoders live on it in fetchFeed()
+  static constexpr int64_t kIdleAfterMs = 5 * 60 * 1000;
+  static constexpr uint32_t kMaxFeedBytes = 2u * 1024u * 1024u;
+  static constexpr int64_t kRequestBudgetMs = 25000;
+  static constexpr int64_t kAlertsEveryMs = 5 * 60 * 1000;   // the alerts feed is ~0.5 MB (~90 KB gzipped)
+  static constexpr int64_t kAlertsValidSec = 15 * 60;        // older alerts are not shown
+
+  void configure(const Config& c);
+  void demand();
+  // From the natives, which run with the render context: a dark display (off when dark, or switched
+  // off) pauses all downloads; nobody can see them. The first one after waking goes at once.
+  void noteDisplay(const RenderCtx* ctx);
+  bool ensureTask();
+  static void taskEntry(void* self);
+  void run();
+  void fetchOnce(const Config& cfg);
+  void fetchFeed(const Config& cfg, const int* lines, int n);
+  void fetchAlerts(const Config& cfg);
+  // One HTTPS GET streamed into decoders[0..n); returns true when they all decoded a whole feed.
+  // wireBytes: what came over the network (gzipped when the MTA sent gzip).
+  bool download(const Config& cfg, const char* url, transit::GtfsRtDecoder* decoders, int n, int& code,
+                char* err, std::size_t errCap, uint32_t& wireBytes);
+  bool alertShown(const Status& s, int64_t nowEpochSec) const;
+  int views(int64_t nowEpochSec, transit::BoardView* out);
+
+  static int nConfig(bvm* vm);
+  static int nState(bvm* vm);
+  static int nShouldShow(bvm* vm);
+  static int nDraw(bvm* vm);
+  static int nStatus(bvm* vm);
+
+  portMUX_TYPE lock_ = portMUX_INITIALIZER_UNLOCKED;
+  Config cfg_;
+  Status st_;
+  uint32_t generation_ = 0;     // bumped by configure(); a result for an older config is dropped
+  TaskHandle_t task_ = nullptr;
+  std::atomic<int64_t> lastDemandMs_{-1};
+  std::atomic<bool> wake_{false};
+  std::atomic<bool> asleep_{false};
+  int64_t connectedAtMs_ = -1;
+  int64_t nextAlertsMs_ = 0;    // fetch task only
+  bool gzipOk_ = true;          // fetch task only: false after repeated gzip failures
+  uint8_t gzipFailures_ = 0;
+  bool lastGzip_ = false;
+};
+
+}  // namespace awtrix
