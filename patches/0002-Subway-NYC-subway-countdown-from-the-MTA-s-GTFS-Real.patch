+static void test_board_states() {
+  FeedSnapshot none;
+  TEST_ASSERT_EQUAL(BoardState::NoClock, viewAt(none, -1, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::NoClock, viewAt(snap({T0 + 300}), 0, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::Loading, viewAt(none, T0, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::Live, viewAt(snap({T0 + 300}), T0 + 10, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::NoArrivals, viewAt(snap({}), T0 + 10, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::NoArrivals, viewAt(snap({T0 - 100}), T0 + 10, 120).state);
+  // an old feed is stale even with future-looking times in it: never an old countdown as live
+  TEST_ASSERT_EQUAL(BoardState::Stale, viewAt(snap({T0 + 900}), T0 + 121, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::Live, viewAt(snap({T0 + 900}), T0 + 120, 120).state);
+  // last attempt failed: fine while the good data is fresh, unavailable afterwards
+  FeedSnapshot f = snap({T0 + 600});
+  f.lastOk = false;
+  f.failures = 2;
+  TEST_ASSERT_EQUAL(BoardState::Live, viewAt(f, T0 + 60, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::Unavailable, viewAt(f, T0 + 200, 120).state);
+  // never had a good feed
+  FeedSnapshot bad;
+  bad.everFinished = true;
+  TEST_ASSERT_EQUAL(BoardState::Unavailable, viewAt(bad, T0, 120).state);
+  // a feed stamped far in the future is not trusted
+  TEST_ASSERT_EQUAL(BoardState::Stale, viewAt(snap({T0 + 900}, T0 + 1000), T0, 120).state);
+  TEST_ASSERT_EQUAL(BoardState::Live, viewAt(snap({T0 + 900}, T0 + 100), T0, 120).state);
+}
