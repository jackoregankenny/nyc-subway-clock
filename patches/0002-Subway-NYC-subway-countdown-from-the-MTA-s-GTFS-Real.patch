diff --git a/src/system/RomInflater.h b/src/system/RomInflater.h
new file mode 100644
index 0000000..14dee61
--- /dev/null
+++ b/src/system/RomInflater.h
@@ -0,0 +1,59 @@
+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// Raw DEFLATE with the tinfl decoder in the ESP32's mask ROM (no code added to flash). It needs a
+// 32 KB window (TINFL_LZ_DICT_SIZE: the MTA's streams use all of it) and ~11 KB of state, taken
+// from the heap by begin() and handed back by the destructor, so they exist only during a download.
+
+#include <esp_heap_caps.h>
+#include <rom/miniz.h>
+
+#include <cstdlib>
+
+#include "core/transit/Gunzip.h"
+
+namespace awtrix {
+
+class RomInflater final : public transit::Inflater {
+ public:
+  static constexpr std::size_t kNeedBytes = sizeof(tinfl_decompressor) + TINFL_LZ_DICT_SIZE;
+
+  ~RomInflater() override {
+    std::free(d_);
+    std::free(dict_);
+  }
+
+  bool begin() {
+    d_ = static_cast<tinfl_decompressor*>(heap_caps_malloc(sizeof(tinfl_decompressor), MALLOC_CAP_8BIT));
+    dict_ = static_cast<uint8_t*>(heap_caps_malloc(TINFL_LZ_DICT_SIZE, MALLOC_CAP_8BIT));
+    if (!d_ || !dict_) return false;
+    tinfl_init(d_);
+    ofs_ = 0;
+    return true;
+  }
+
+  Result step(const uint8_t* in, std::size_t len, std::size_t& used, Out out, void* ctx) override {
+    used = 0;
+    for (;;) {
+      size_t inSz = len - used, outSz = TINFL_LZ_DICT_SIZE - ofs_;
+      // The window wraps: output goes to dict_ + ofs_, back references read the whole buffer.
+      const tinfl_status st = tinfl_decompress(d_, in + used, &inSz, dict_, dict_ + ofs_, &outSz,
+                                               TINFL_FLAG_HAS_MORE_INPUT);
+      used += inSz;
+      if (outSz && !out(ctx, dict_ + ofs_, outSz)) return Result::Error;
+      ofs_ = (ofs_ + outSz) & (TINFL_LZ_DICT_SIZE - 1);
+      if (st == TINFL_STATUS_DONE) return Result::Done;
+      if (st < 0) return Result::Error;
+      if (st == TINFL_STATUS_NEEDS_MORE_INPUT && used == len) return Result::More;
+      if (inSz == 0 && outSz == 0 && st == TINFL_STATUS_NEEDS_MORE_INPUT) return Result::More;
+    }
+  }
+
+ private:
+  tinfl_decompressor* d_ = nullptr;
+  uint8_t* dict_ = nullptr;
+  std::size_t ofs_ = 0;
+};
+
+}  // namespace awtrix
diff --git a/src/system/SubwayScript.h b/src/system/SubwayScript.h
new file mode 100644
index 0000000..63c43fe
--- /dev/null
+++ b/src/system/SubwayScript.h
@@ -0,0 +1,69 @@
+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// The Subway app, installed once on first boot (see GiftDefaults.cpp). It is an ordinary AWTRIX
+// script: it sits in the rotation, its settings are on the Apps tab (gear icon), and it can be
+// edited, switched off or deleted from the web UI like any other. The fetching, decoding and
+// drawing are native (MtaFeedService); the script only carries the settings and the hooks.
+//
+// Bump kSubwayScriptVersion to replace an installed copy on the next boot. The user's settings
+// live in the script's store and survive a replacement.
+
+inline constexpr int kSubwayScriptVersion = 5;
+inline constexpr const char* kSubwayScriptName = "Subway";
+
+inline constexpr const char kSubwayScript[] = R"BERRY(# @name    Subway
+# @desc    Next trains at your station, any NYC subway line, live from the MTA
+# @author  B-train gift clock
+# @version 1.5
+# @config  route     text   "Lines"      default="B,C,A" maxlen=11 help="Up to three subway lines at the station, e.g. B or B,C,A. Each line's times show in its own color; a line not stopping right now (the A by day) stays hidden. Any of 1-7, A, B, C ... Z, GS, FS, H, SI, 6X, 7X, FX"
+# @config  station   text   "Station ID" default="A21" maxlen=15 help="From the station list (docs/STATIONS.md). 81 St-Museum of Natural History is A21"
+# @config  direction select "Direction"  default=S options=S,N help="The station list says what S and N mean at your station. At 81 St: S = Downtown, N = Uptown"
+# @config  layout    select "Layout"  default=numbers options=numbers,bullets,turns help="numbers: the next trains of all lines in time order, each in its line's color, no letters, N = arriving. bullets: two lines' bullets and next trains side by side. turns: one line at a time with its bullet, switching every 5 s"
+# @config  alerts    bool   "Red dot for MTA alerts" default=true help="A red dot in the top-right corner while the MTA reports delays or other unplanned trouble on one of the lines. Planned work does not count"
+# @config  offline   bool   "Show when live times are unavailable" default=true help="A gray - - instead of skipping the app"
+# @config  dwell     number "Time on screen" default=10 min=3 max=60 unit=s
+# @config  feed      text   "Feed URL"   default="" hint=automatic maxlen=250 group="Advanced" help="Leave empty: the clock picks the MTA feed for the line"
+# @config  every     number "Refresh every" default=30 min=20 max=600 unit=s group="Advanced"
+# @config  stale     number "Old after"  default=120 min=60 max=1800 unit=s group="Advanced" help="Times from an older feed are never shown"
+# @config  verify    bool   "Verify the MTA certificate" default=true group="Advanced" help="Leave on. Switch off only if the log says the TLS check fails because the MTA changed certificate authority"
+
+class Subway
+  var route, offline, dwell, last
+
+  def init()
+    self.route = store.get("route", "B,C,A")
+    self.offline = store.get("offline", true)
+    self.dwell = int(store.get("dwell", 10)) * 1000
+    self.last = ""
+    subway_config(self.route, store.get("station", "A21"), store.get("direction", "S"),
+                  store.get("feed", ""), int(store.get("every", 30)), int(store.get("stale", 120)),
+                  store.get("verify", true), store.get("layout", "numbers"),
+                  store.get("alerts", true))
+  end
+
+  def loop()
+    var st = subway_state()
+    if st != self.last
+      log(subway_status())
+      self.last = st
+    end
+  end
+
+  def should_show()
+    return subway_should_show(self.offline)
+  end
+
+  def duration()
+    return self.dwell
+  end
+
+  def draw()
+    clear()
+    subway_draw(self.route)
+  end
+end
+
+return Subway()
+)BERRY";
