--- /dev/null
+++ b/src/core/transit/GtfsRtDecoder.h
@@ -0,0 +1,170 @@
+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// A push-style, bounded-memory decoder for the few GTFS-Realtime fields an arrival countdown needs.
+// Bytes go in through feed() in pieces of any size, as they come off the socket; nothing of the
+// feed is buffered beyond one short string. Memory use is a fixed sizeof(GtfsRtDecoder), whatever
+// the size of the feed.
+//
+// Field numbers are from the official gtfs-realtime.proto (google/transit, checked 2026-11-10):
+//   FeedMessage   header=1 entity=2
+//   FeedHeader    timestamp=3 (uint64)
+//   FeedEntity    is_deleted=2 trip_update=3
+//   TripUpdate    trip=1 stop_time_update=2
+//   TripDescriptor schedule_relationship=4 route_id=5     (CANCELED=3, DELETED=7)
+//   StopTimeUpdate arrival=2 departure=3 stop_id=4 schedule_relationship=5   (SKIPPED=1)
+//   StopTimeEvent time=2 (int64, Unix seconds)
+// Alerts mode (beginAlerts), for the MTA's subway-alerts feed:
+//   FeedEntity    alert=5
+//   Alert         active_period=1 informed_entity=5, MTA Mercury extension=1001
+//   TimeRange     start=1 end=2 (uint64; 0 or absent = open)
+//   EntitySelector route_id=2
+//   MercuryAlert  alert_type=3 (string: "Delays", "Planned - Stops Skipped", ...)
+// Everything else, including the MTA's NYCT extensions (field 1001) in trip feeds, is skipped by
+// wire type.
+// Fields may come in any order: decisions are taken when the enclosing message ends.
+
+#include <cstddef>
+#include <cstdint>
+
+namespace awtrix::transit {
+
+enum class DecodeError : uint8_t {
+  None = 0,
+  BadVarint,       // more than 10 bytes, or a value too large for its use
+  BadWireType,     // groups (3/4) or the reserved wire types 6/7
+  BadFieldNumber,  // field number 0
+  LengthOverrun,   // a nested length runs past the message that holds it
+  Oversized,       // more bytes than the decoder was told to accept
+  Truncated,       // input ended inside a field or a nested message
+};
+
+const char* decodeErrorName(DecodeError e);
+
+class GtfsRtDecoder {
+ public:
+  static constexpr std::size_t kMaxId = 15;        // longest route or stop id compared
+  static constexpr std::size_t kMaxArrivals = 8;   // earliest times kept
+  static constexpr std::size_t kMaxTripStops = 4;  // matching stop visits buffered per trip
+  static constexpr int kMaxDepth = 7;
+
+  // route and stop are copied; ids longer than kMaxId never match. cutoffSec drops times
+  // earlier than it (0 keeps everything). maxBytes caps the input size (0 = no cap).
+  void begin(const char* route, const char* stop, int64_t cutoffSec, uint64_t maxBytes);
+
+  // Alerts mode: looks for alerts in effect at nowSec that name one of `routes` (at most
+  // kMaxAlertRoutes) and are not planned work or good news (isDisruption). alertMask() then has
+  // bit i set for routes[i].
+  static constexpr int kMaxAlertRoutes = 3;
+  void beginAlerts(const char* const* routes, int n, int64_t nowSec, uint64_t maxBytes);
+  uint8_t alertMask() const { return alertMask_; }
+  uint32_t alerts() const { return alerts_; }
+  // "Delays", "Reduced Service", "Suspended" ...: yes. "Planned - ...", "Extra Service",
+  // "Station Notice", "Boarding Change", "Special Schedule": no. Only the first kMaxId characters
+  // are compared.
+  static bool isDisruption(const char* alertType);
+
+  // False once an error has been seen; later input is ignored.
+  bool feed(const uint8_t* data, std::size_t len);
+  // Call at the end of input. False when the feed is incomplete or was malformed.
+  bool finish();
+
+  DecodeError error() const { return error_; }
+  uint64_t bytes() const { return pos_; }
+  uint64_t headerTimestamp() const { return headerTs_; }  // 0 when absent
+  uint32_t entities() const { return entities_; }
+  uint32_t tripUpdates() const { return tripUpdates_; }
+  uint32_t routeTrips() const { return routeTrips_; }  // trip updates of the wanted route
+  // Stop time updates at the wanted stop, any route. With routeTrips() this tells a wrong route or
+  // stop id (zero) apart from a right one that simply has no train coming.
+  uint32_t stopVisits() const { return stopVisits_; }
+
+  // Distinct arrival times at the stop, ascending, at most kMaxArrivals.
+  std::size_t count() const { return count_; }
+  int64_t at(std::size_t i) const { return times_[i]; }
+
+ private:
+  enum class Msg : uint8_t {
+    Feed, Header, Entity, TripUpdate, Trip, StopTime, Arrival, Departure,
+    Alert, Period, Informed, Mercury
+  };
+  enum class St : uint8_t { Tag, Varint, Len, Skip, String };
+
+  struct Frame {
+    Msg msg;
+    uint64_t end;  // absolute offset where the message ends; UINT64_MAX for the top level
+  };
+
+  struct Str {
+    char buf[kMaxId + 1];
+    uint8_t len;
+    bool overflow;
+    bool set;
+    void clear() { len = 0; overflow = false; set = false; buf[0] = 0; }
+    bool equals(const Str& o) const;
+  };
+
+  bool fail(DecodeError e);
+  bool fieldDone();
+  void onVarint(uint64_t v);
+  bool onLength(uint64_t len);
+  void openMsg(Msg m);
+  void closeMsg(Msg m);
+  void addTime(int64_t t);
+
+  // configuration
+  Str route_{}, stop_{};
+  int64_t cutoff_ = 0;
+  uint64_t maxBytes_ = 0;
+
+  // wire state
+  St st_ = St::Tag;
+  uint64_t pos_ = 0;
+  uint64_t acc_ = 0;
+  uint8_t shift_ = 0;
+  uint32_t field_ = 0;
+  uint8_t wire_ = 0;
+  uint64_t remain_ = 0;  // bytes left of a skip or string
+  Frame stack_[kMaxDepth]{};
+  int depth_ = 0;
+  Str* target_ = nullptr;  // string being captured
+  DecodeError error_ = DecodeError::None;
+
+  // message state, reset when the message opens
+  bool entDeleted_ = false;
+  bool entHasTrip_ = false;
+  bool tuRouteMatch_ = false;
+  bool tuCancelled_ = false;
+  int64_t tuTimes_[kMaxTripStops]{};
+  uint8_t tuCount_ = 0;
+  Str tripRoute_{};
+  uint32_t tripRel_ = 0;
+  Str stuStop_{};
+  uint32_t stuRel_ = 0;
+  int64_t stuArr_ = 0, stuDep_ = 0;
+  int64_t evTime_ = 0;
+  bool pendTrip_ = false;  // entity's trip update result, decided when the entity ends
+  int64_t pendTimes_[kMaxTripStops]{};
+  uint8_t pendCount_ = 0;
+
+  // alerts mode
+  bool alertsMode_ = false;
+  Str alertRoutes_[kMaxAlertRoutes]{};
+  int nAlertRoutes_ = 0;
+  int64_t now_ = 0;
+  uint64_t perStart_ = 0, perEnd_ = 0;
+  bool alHasPeriod_ = false, alActive_ = false;
+  uint8_t alMask_ = 0, pendAlert_ = 0;
+  Str informedRoute_{}, alertType_{};
+
+  // results
+  uint8_t alertMask_ = 0;
+  uint32_t alerts_ = 0;
+  uint64_t headerTs_ = 0;
+  uint32_t entities_ = 0, tripUpdates_ = 0, routeTrips_ = 0, stopVisits_ = 0;
+  int64_t times_[kMaxArrivals]{};
+  std::size_t count_ = 0;
+};
+
+}  // namespace awtrix::transit
diff --git a/src/core/transit/Gunzip.h b/src/core/transit/Gunzip.h
new file mode 100644
index 0000000..4f6d9f8
--- /dev/null
+++ b/src/core/transit/Gunzip.h
@@ -0,0 +1,167 @@
+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// Streaming gzip (RFC 1952) unwrapper for the MTA feeds, which come about 5x smaller gzipped
+// (bdfm 161 -> 31 KB, alerts 555 -> 88 KB). Bytes go in as they come off the socket; the inflated
+// bytes are handed on as they come out, so nothing of the feed is kept but the DEFLATE window.
+//
+// This class does the gzip framing: the header (with its optional extra, name, comment and header
+// CRC), the CRC-32 and length in the trailer. The trailer is read as the last 8 bytes of the input,
+// not as the bytes after the DEFLATE end: the ESP32's ROM tinfl (miniz 1.x) reads up to 4 bytes
+// ahead into its bit buffer and does not hand them back, so after its "done" some of the trailer
+// is already gone (seen on the clock 2026-11-13: alerts and ace failed, bdfm passed, by luck of
+// alignment). The MTA sends one gzip member and nothing after it. The DEFLATE decoding itself is an Inflater: the
+// ESP32's ROM tinfl on the device (system/RomInflater.h), zlib in the host tests. The MTA's
+// streams use the full 32 KB window, so the device needs a 32 KB buffer plus ~11 KB of decoder
+// state while a download runs; both are freed when it ends.
+
+#include <cstddef>
+#include <cstdint>
+
+namespace awtrix::transit {
+
+class Inflater {
+ public:
+  enum class Result : uint8_t { More, Done, Error };
+  using Out = bool (*)(void* ctx, const uint8_t* data, std::size_t len);
+  virtual ~Inflater() = default;
+  // Raw DEFLATE: consumes from in[0..len), sets `used`, hands output to out(). More: all of the
+  // input was used and the stream goes on; Done: the stream ended after `used` bytes; Error:
+  // damaged data, or out() returned false.
+  virtual Result step(const uint8_t* in, std::size_t len, std::size_t& used, Out out, void* ctx) = 0;
+};
+
+class Gunzip {
+ public:
+  Gunzip(Inflater& inflater, Inflater::Out out, void* ctx) : inf_(inflater), out_(out), ctx_(ctx) {}
+
+  // False once anything is wrong; later input is ignored.
+  bool feed(const uint8_t* data, std::size_t len) {
+    keepTail(data, len);
+    std::size_t i = 0;
+    while (i < len && st_ != St::Error) {
+      switch (st_) {
+        case St::Header: {
+          hdr_[hdrLen_++] = data[i++];
+          if (hdrLen_ < 10) break;
+          if (hdr_[0] != 0x1f || hdr_[1] != 0x8b || hdr_[2] != 8 || (hdr_[3] & 0xE0)) return fail("not gzip");
+          flags_ = hdr_[3];
+          st_ = St::Optional;
+          break;
+        }
+        case St::Optional:
+          if (flags_ & kExtra) {  // 2-byte length, then that many bytes
+            if (skipLenBytes_ < 2) {
+              skip_ |= static_cast<uint32_t>(data[i++]) << (8 * skipLenBytes_);
+              if (++skipLenBytes_ == 2 && skip_ == 0) flags_ &= ~kExtra;
+              break;
+            }
+            const std::size_t n = len - i < skip_ ? len - i : skip_;
+            i += n;
+            skip_ -= static_cast<uint32_t>(n);
+            if (skip_ == 0) flags_ &= ~kExtra;
+          } else if (flags_ & kName) {
+            if (data[i++] == 0) flags_ &= ~kName;
+          } else if (flags_ & kComment) {
+            if (data[i++] == 0) flags_ &= ~kComment;
+          } else if (flags_ & kHeaderCrc) {
+            ++i;
+            if (++hcrc_ == 2) flags_ &= ~kHeaderCrc;
+          } else {
+            st_ = St::Body;
+          }
+          break;
+        case St::Body: {
+          std::size_t used = 0;
+          const Inflater::Result r = inf_.step(data + i, len - i, used, &Gunzip::onOut, this);
+          i += used;
+          if (r == Inflater::Result::Error) return fail(sinkRefused_ ? "refused" : "bad deflate data");
+          if (r == Inflater::Result::Done) st_ = St::Trailer;
+          break;
+        }
+        case St::Trailer:  // the rest of the input; checked by done() from the last 8 bytes
+          i = len;
+          break;
+        case St::Error:
+          break;
+      }
+    }
+    // With an empty Optional section, the switch to Body happens on the next byte; settle it here
+    // so done() is right at a boundary too.
+    if (st_ == St::Optional && !(flags_ & (kExtra | kName | kComment | kHeaderCrc))) st_ = St::Body;
+    return st_ != St::Error;
+  }
+
+  // The whole stream arrived and checked out: DEFLATE ended, and the input's last 8 bytes are the
+  // CRC-32 and length of what came out.
+  bool done() const { return st_ == St::Trailer && trailerMatches(); }
+  // Mid-stream errors; at the end of the input also a trailer that does not match.
+  const char* error() const {
+    if (st_ == St::Trailer && !trailerMatches()) return "crc or length mismatch";
+    return error_;
+  }
+  uint32_t outBytes() const { return outLen_; }
+
+  static uint32_t crc32Update(uint32_t crc, const uint8_t* p, std::size_t n) {
+    // Nibble table: 64 bytes instead of 1 KB, ~2 lookups per byte; fast enough for half a MB.
+    static constexpr uint32_t kT[16] = {
+        0x00000000u, 0x1DB71064u, 0x3B6E20C8u, 0x26D930ACu, 0x76DC4190u, 0x6B6B51F4u, 0x4DB26158u, 0x5005713Cu,
+        0xEDB88320u, 0xF00F9344u, 0xD6D6A3E8u, 0xCB61B38Cu, 0x9B64C2B0u, 0x86D3D2D4u, 0xA00AE278u, 0xBDBDF21Cu};
+    for (std::size_t i = 0; i < n; ++i) {
+      crc ^= p[i];
+      crc = (crc >> 4) ^ kT[crc & 15];
+      crc = (crc >> 4) ^ kT[crc & 15];
+    }
+    return crc;
+  }
+
+ private:
+  enum class St : uint8_t { Header, Optional, Body, Trailer, Error };
+  static constexpr uint8_t kHeaderCrc = 2, kExtra = 4, kName = 8, kComment = 16;
+
+  static uint32_t rd32(const uint8_t* p) {
+    return p[0] | (static_cast<uint32_t>(p[1]) << 8) | (static_cast<uint32_t>(p[2]) << 16) |
+           (static_cast<uint32_t>(p[3]) << 24);
+  }
+  void keepTail(const uint8_t* d, std::size_t n) {
+    for (std::size_t k = n > 8 ? n - 8 : 0; k < n; ++k) {
+      tail_[tailPos_] = d[k];
+      tailPos_ = (tailPos_ + 1) & 7;
+    }
+  }
+  bool trailerMatches() const {
+    uint8_t t[8];
+    for (int k = 0; k < 8; ++k) t[k] = tail_[(tailPos_ + k) & 7];  // oldest first
+    return rd32(t) == ~crc_ && rd32(t + 4) == outLen_;
+  }
+  static bool onOut(void* self, const uint8_t* d, std::size_t n) {
+    Gunzip& g = *static_cast<Gunzip*>(self);
+    g.crc_ = crc32Update(g.crc_, d, n);
+    g.outLen_ += static_cast<uint32_t>(n);
+    if (!g.out_(g.ctx_, d, n)) {
+      g.sinkRefused_ = true;
+      return false;
+    }
+    return true;
+  }
+  bool fail(const char* why) {
+    if (st_ != St::Error) error_ = why;
+    st_ = St::Error;
+    return false;
+  }
+
+  Inflater& inf_;
+  Inflater::Out out_;
+  void* ctx_;
+  St st_ = St::Header;
+  uint8_t hdr_[10] = {};
+  uint8_t hdrLen_ = 0, flags_ = 0, skipLenBytes_ = 0, hcrc_ = 0, tailPos_ = 0;
+  uint32_t skip_ = 0;
+  uint8_t tail_[8] = {};
+  uint32_t crc_ = 0xFFFFFFFFu, outLen_ = 0;
+  bool sinkRefused_ = false;
+  const char* error_ = "";
+};
+
+}  // namespace awtrix::transit
diff --git a/src/core/transit/Routes.h b/src/core/transit/Routes.h
new file mode 100644
index 0000000..c04e19e
--- /dev/null
+++ b/src/core/transit/Routes.h
@@ -0,0 +1,115 @@
+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// Every NYC subway route: which MTA GTFS-Realtime feed carries it, its official bullet color and
+// the character on its bullet. Colors and bullet text are route_color / route_short_name from the
+// MTA's static GTFS (routes.txt, rrgtfsfeeds gtfs_subway.zip); the route -> feed split was read
+// from the live feeds on 2026-11-10 (route ids seen in each feed's trip updates).
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+namespace awtrix::transit {
+
+struct RouteInfo {
+  const char* id;     // GTFS route_id
+  const char* feed;   // suffix after nyct%2F in the MTA feed URL
+  uint32_t color;     // route_color
+  char bullet;        // the character on the bullet
+  bool express;       // an express variant (6X, 7X, FX). The MTA draws these as a diamond; at
+                      // 7 px a diamond cannot hold a cut-out letter, so the clock uses the disc
+};
+
+inline constexpr const char* kMtaFeedBase = "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2F";
+inline constexpr uint32_t kUnknownRouteColor = 0x7C858Cu;  // the MTA's shuttle gray
+
+inline constexpr RouteInfo kRoutes[] = {
+    {"1", "gtfs", 0xD82233u, '1', false},      {"2", "gtfs", 0xD82233u, '2', false},
+    {"3", "gtfs", 0xD82233u, '3', false},      {"4", "gtfs", 0x009952u, '4', false},
+    {"5", "gtfs", 0x009952u, '5', false},      {"6", "gtfs", 0x009952u, '6', false},
+    {"6X", "gtfs", 0x009952u, '6', true},      {"7", "gtfs", 0x9A38A1u, '7', false},
+    {"7X", "gtfs", 0x9A38A1u, '7', true},      {"GS", "gtfs", 0x7C858Cu, 'S', false},
+    {"A", "gtfs-ace", 0x0062CFu, 'A', false},  {"C", "gtfs-ace", 0x0062CFu, 'C', false},
+    {"E", "gtfs-ace", 0x0062CFu, 'E', false},  {"H", "gtfs-ace", 0x7C858Cu, 'S', false},
+    {"B", "gtfs-bdfm", 0xEB6800u, 'B', false}, {"D", "gtfs-bdfm", 0xEB6800u, 'D', false},
+    {"F", "gtfs-bdfm", 0xEB6800u, 'F', false}, {"FX", "gtfs-bdfm", 0xEB6800u, 'F', true},
+    {"M", "gtfs-bdfm", 0xEB6800u, 'M', false}, {"FS", "gtfs-bdfm", 0x7C858Cu, 'S', false},
+    {"G", "gtfs-g", 0x799534u, 'G', false},    {"J", "gtfs-jz", 0x8E5C33u, 'J', false},
+    {"Z", "gtfs-jz", 0x8E5C33u, 'Z', false},   {"L", "gtfs-l", 0x7C858Cu, 'L', false},
+    {"N", "gtfs-nqrw", 0xF6BC26u, 'N', false}, {"Q", "gtfs-nqrw", 0xF6BC26u, 'Q', false},
+    {"R", "gtfs-nqrw", 0xF6BC26u, 'R', false}, {"W", "gtfs-nqrw", 0xF6BC26u, 'W', false},
+    {"SI", "gtfs-si", 0x08179Cu, 'S', false},
+};
+
+// Case-insensitive; null for a route the table does not know.
+inline const RouteInfo* findRoute(const char* id) {
+  if (!id) return nullptr;
+  for (const RouteInfo& r : kRoutes) {
+    std::size_t i = 0;
+    for (; r.id[i] && id[i]; ++i) {
+      char c = id[i];
+      if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 32);
+      if (c != r.id[i]) break;
+    }
+    if (!r.id[i] && !id[i]) return &r;
+  }
+  return nullptr;
+}
+
+// Route ids in the feeds are upper case ("6X", "GS"); accept what a person types.
+inline std::string normalizeRoute(const char* id) {
+  std::string out;
+  for (const char* p = id ? id : ""; *p; ++p) {
+    char c = *p;
+    if (c == ' ') continue;
+    if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 32);
+    out.push_back(c);
+  }
+  return out;
+}
+
+// Service alerts for every subway line (GTFS-RT Alerts with the MTA's Mercury extension).
+inline constexpr const char* kMtaAlertsUrl =
+    "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fsubway-alerts";
+
+// "B,C", "b c", "B+C" or "B/C" -> {"B", "C"}: up to `max` distinct routes, in the order typed.
+inline int parseRoutes(const char* list, std::string* out, int max) {
+  int n = 0;
+  std::string cur;
+  auto flush = [&] {
+    const std::string r = normalizeRoute(cur.c_str());
+    cur.clear();
+    if (r.empty() || n >= max) return;
+    for (int i = 0; i < n; ++i)
+      if (out[i] == r) return;
+    out[n++] = r;
+  };
+  for (const char* p = list ? list : ""; *p; ++p) {
+    if (*p == ',' || *p == ' ' || *p == '+' || *p == '/' || *p == ';') flush();
+    else cur.push_back(*p);
+  }
+  flush();
+  return n;
+}
+
+// The feed for a route, or "" when the route is unknown (the caller then needs an explicit URL).
+inline std::string feedUrlFor(const char* route) {
+  const RouteInfo* r = findRoute(route);
+  return r ? std::string(kMtaFeedBase) + r->feed : std::string();
+}
+
+// "A21" + 'S' -> "A21S". A station typed with its direction already ("A21S", "a21n") is kept as
+// it is, upper-cased: GTFS parent station ids end in a digit, platform ids in N or S.
+inline std::string stopIdFor(const char* station, char direction) {
+  std::string s = normalizeRoute(station);
+  if (s.empty()) return s;
+  const char last = s.back();
+  if (last == 'N' || last == 'S') return s;
+  s.push_back(direction == 'N' || direction == 'n' ? 'N' : 'S');
+  return s;
+}
+
+}  // namespace awtrix::transit
diff --git a/src/core/transit/SubwayView.h b/src/core/transit/SubwayView.h
new file mode 100644
index 0000000..7eb0bb2
--- /dev/null
+++ b/src/core/transit/SubwayView.h
@@ -0,0 +1,228 @@
+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// The one layout of the Subway app, shared by the device (through the subway_draw() script
+// native) and the host preview, so the preview shows the pixels the clock will show.
+//
+//   col 0-6   the route bullet: a 7x7 disc in the line's MTA color, its letter cut out of it.
+//             Express variants (6X, 7X, FX) use the disc too: a 7-px diamond loses the letter.
+//   col 8-31  the countdowns, centred as one group: first train in the text color, a dim dot,
+//             the second train dimmer. Under a minute reads NOW. No leading zeros ("4 . 11", not
+//             "04 11", which reads as a time); 99 is the cap. One train: "12 MIN", MIN dim.
+//   no data   gray bullet and a dim "- -": stale, unavailable or not loaded yet. Never a number.
+//
+// Nothing scrolls. In the AWTRIX font NOW is 14 px of ink (W is 5 wide) and two digits 7 px: the
+// widest group "NOW . 99" fits the 24 columns with 1-px gaps, everything else gets 2 or 3. Two
+// trains both under a minute cannot both read NOW, so that shows a single NOW.
+
+#include <cstdint>
+#include <string>
+
+#include "core/render/Canvas.h"
+#include "core/render/Color.h"
+#include "core/render/Font.h"
+#include "core/render/TextRenderer.h"
+#include "core/transit/ArrivalBoard.h"
+#include "core/transit/Routes.h"
+
+namespace awtrix::transit {
+
+struct SubwayStyle {
+  char letter = 'B';
+  uint32_t badge = 0xEB6800u;
+  uint32_t text = 0xFFFFFFu;   // first train
+  uint8_t secondLevel = 150;   // second train, as a scale8 level of `text`
+  uint8_t labelLevel = 90;     // the dot and MIN
+
+  static SubwayStyle forRoute(const char* route) {
+    SubwayStyle s;
+    if (const RouteInfo* r = findRoute(route)) {
+      s.letter = r->bullet;
+      s.badge = r->color;
+    } else {
+      const std::string n = normalizeRoute(route);
+      s.letter = n.empty() ? '?' : n[0];
+      s.badge = kUnknownRouteColor;
+    }
+    return s;
+  }
+};
+
+constexpr int kBadgeW = 7;
+constexpr int kEtaLeft = 8;
+constexpr int kBaseline = 6;
+constexpr int kDotRow = 3;
+constexpr uint32_t kNoDataBadge = 0x404040u;
+constexpr uint32_t kNoDataText = 0x606060u;
+
+inline std::string minutesText(int m) { return m == BoardView::kNow ? std::string("NOW") : std::to_string(m); }
+
+// Row spans of the disc, inclusive columns.
+struct Span { int8_t from, to; };
+inline constexpr Span kDisc[kBadgeW] = {{2, 4}, {1, 5}, {0, 6}, {0, 6}, {0, 6}, {1, 5}, {2, 4}};
+
+inline void drawBadge(Canvas& c, const GfxFont& font, char letter, uint32_t color, int x0 = 0) {
+  for (int y = 0; y < kBadgeW; ++y)
+    for (int x = kDisc[y].from; x <= kDisc[y].to; ++x) c.setPixel(x0 + x, y, color);
+  const std::string s(1, letter);
+  const text::TextMetrics m = text::measure(font, s, true);
+  const int x = x0 + (kBadgeW - m.inkWidth()) / 2 - m.inkLeft;
+  c.setClipX(x0, x0 + kBadgeW - 1);
+  text::drawText(c, font, x, kBaseline, s, 0x000000u);
+  c.clearClipX();
+}
+
+// Draws s with its ink starting at column x; returns the column after the ink.
+inline int drawInkAt(Canvas& c, const GfxFont& font, const std::string& s, int x, uint32_t color) {
+  const text::TextMetrics m = text::measure(font, s, true);
+  text::drawText(c, font, x - m.inkLeft, kBaseline, s, color);
+  return x + m.inkWidth();
+}
+
+inline int inkWidth(const GfxFont& font, const std::string& s) { return text::measure(font, s, true).inkWidth(); }
+
+inline void renderSubway(Canvas& c, const GfxFont& font, const BoardView& v, const SubwayStyle& st) {
+  const int areaW = c.width() - kEtaLeft;
+  if (v.state != BoardState::Live) {
+    drawBadge(c, font, st.letter, kNoDataBadge);
+    text::drawCenteredIn(c, font, "- -", kBaseline, kNoDataText, kEtaLeft, areaW);
+    return;
+  }
+  drawBadge(c, font, st.letter, st.badge);
+  const uint32_t second = color::scale8(st.text, st.secondLevel);
+  const uint32_t label = color::scale8(st.text, st.labelLevel);
+  const std::string a = minutesText(v.minutes[0]);
+  const int wa = inkWidth(font, a);
+
+  if (v.trains >= 2 && !(v.minutes[0] == BoardView::kNow && v.minutes[1] == BoardView::kNow)) {
+    const std::string b = minutesText(v.minutes[1]);
+    const int wb = inkWidth(font, b);
+    int gap = 3;
+    while (gap > 1 && wa + wb + 2 * gap + 1 > areaW) --gap;
+    const int total = wa + 2 * gap + 1 + wb;
+    int x = kEtaLeft + (areaW - total + 1) / 2;
+    x = drawInkAt(c, font, a, x, st.text) + gap;
+    c.setPixel(x, kDotRow, label);
+    drawInkAt(c, font, b, x + 1 + gap, second);
+    return;
+  }
+  if (v.minutes[0] == BoardView::kNow) {
+    drawInkAt(c, font, a, kEtaLeft + (areaW - wa + 1) / 2, st.text);
+    return;
+  }
+  const std::string unit = "MIN";
+  const int wu = inkWidth(font, unit);
+  const int gap = 3;
+  const int x = kEtaLeft + (areaW - (wa + gap + wu) + 1) / 2;
+  drawInkAt(c, font, unit, drawInkAt(c, font, a, x, st.text) + gap, label);
+}
+
+// Up to three lines at one station (B, C and the overnight A at 81 St). Three layouts, picked in
+// the app's settings:
+//
+//   Numbers    no bullets, just the next trains of both lines in time order, each number in its
+//              line's color (B orange, C blue), centred across the whole width. As many as fit, at
+//              most four, 3-px gaps (2 when tight). A lone train reads "12 MIN".
+//   Bullets    side by side: each 16-px half is a live line's bullet and its next train (the first
+//              two live lines when three are). NOW is 14 px
+//              and the half has 8 columns for the time, so a train under a minute reads N there.
+//   Turns      one live line at a time in the single-line layout above, switching every kTurnMs.
+//
+// In Numbers and Bullets a train under a minute reads N (5 px) rather than NOW (14 px).
+// Any layout: a red dot in the top-right corner (col 31, row 0, which text never uses) while the
+// MTA reports a disruption on one of the lines (MtaFeedService fetches the alerts).
+//
+// In every layout a line without live times drops out (B and C overnight, or the A by day, when it
+// runs express past 81 St) and the others get the screen; with none live, a dim "- -" (gray bullets
+// in Bullets).
+constexpr int kMaxLines = 3;
+constexpr int64_t kTurnMs = 5000;
+constexpr uint32_t kAlertDot = 0xFF0000u;
+
+inline std::string shortMinutes(int m) { return m == BoardView::kNow ? std::string("N") : std::to_string(m); }
+
+inline void drawAlertDot(Canvas& c) { c.setPixel(c.width() - 1, 0, kAlertDot); }
+
+enum class Layout : uint8_t { Numbers, Bullets, Turns };
+
+inline Layout layoutFromName(const char* s) {
+  const std::string n = normalizeRoute(s);
+  if (n == "BULLETS" || n == "SIDE") return Layout::Bullets;
+  if (n == "TURNS" || n == "ALTERNATE") return Layout::Turns;
+  return Layout::Numbers;
+}
+
+inline void drawHalf(Canvas& c, const GfxFont& font, int x0, const BoardView& v, const SubwayStyle& st) {
+  const int left = x0 + kEtaLeft, w = c.width() / 2 - kEtaLeft;
+  const bool live = v.state == BoardState::Live;
+  drawBadge(c, font, st.letter, live ? st.badge : kNoDataBadge, x0);
+  const std::string t = live ? shortMinutes(v.minutes[0]) : std::string("-");
+  drawInkAt(c, font, t, left + (w - inkWidth(font, t) + 1) / 2, live ? st.text : kNoDataText);
+}
+
+inline void renderBoard(Canvas& c, const GfxFont& font, const BoardView* v, const SubwayStyle* st, int lines,
+                        Layout layout = Layout::Numbers, int64_t nowMs = 0) {
+  if (lines < 2) {
+    renderSubway(c, font, v[0], st[0]);
+    return;
+  }
+  if (layout != Layout::Numbers) {
+    // The live lines, in the order typed; with none live, every line (each drawn gray).
+    int idx[kMaxLines], k = 0;
+    for (int i = 0; i < lines && i < kMaxLines; ++i)
+      if (v[i].state == BoardState::Live) idx[k++] = i;
+    if (k == 0)
+      for (int i = 0; i < lines && i < kMaxLines; ++i) idx[k++] = i;
+    if (k == 1) {
+      renderSubway(c, font, v[idx[0]], st[idx[0]]);
+    } else if (layout == Layout::Turns) {
+      const int i = idx[static_cast<int>((nowMs / kTurnMs) % k)];
+      renderSubway(c, font, v[i], st[i]);
+    } else {  // two halves: the first two live lines
+      drawHalf(c, font, 0, v[idx[0]], st[idx[0]]);
+      drawHalf(c, font, c.width() / 2, v[idx[1]], st[idx[1]]);
+    }
+    return;
+  }
+  struct Eta { int m; uint32_t color; std::string s; int w; };
+  Eta e[2 * kMaxLines];
+  int n = 0;
+  for (int i = 0; i < lines && i < kMaxLines; ++i) {
+    if (v[i].state != BoardState::Live) continue;
+    for (int k = 0; k < v[i].trains && k < 2; ++k) {
+      Eta x{v[i].minutes[k], st[i].badge, shortMinutes(v[i].minutes[k]), 0};
+      x.w = inkWidth(font, x.s);
+      int j = n++;
+      for (; j > 0 && e[j - 1].m > x.m; --j) e[j] = e[j - 1];  // stable: B before C on a tie
+      e[j] = x;
+    }
+  }
+  const int W = c.width();
+  if (n == 0) {
+    text::drawCenteredIn(c, font, "- -", kBaseline, kNoDataText, 0, W);
+    return;
+  }
+  if (n == 1 && e[0].m != BoardView::kNow) {
+    const std::string unit = "MIN";
+    const int wu = inkWidth(font, unit);
+    const int x = (W - (e[0].w + 3 + wu) + 1) / 2;
+    drawInkAt(c, font, unit, drawInkAt(c, font, e[0].s, x, e[0].color) + 3,
+              color::scale8(st[0].text, st[0].labelLevel));
+    return;
+  }
+  int count = n < 4 ? n : 4, gap = 3;  // at most four: more is too much to read at a glance
+  auto width = [&](int k, int g) {
+    int w = g * (k - 1);
+    for (int i = 0; i < k; ++i) w += e[i].w;
+    return w;
+  };
+  while (width(count, gap) > W) {
+    if (gap > 2) --gap;
+    else { --count; gap = 3; }
+  }
+  int x = (W - width(count, gap) + 1) / 2;
+  for (int i = 0; i < count; ++i) x = drawInkAt(c, font, e[i].s, x, e[i].color) + gap;
+}
+
+}  // namespace awtrix::transit
