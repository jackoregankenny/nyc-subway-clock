+// B-train gift clock addition (not upstream AWTRIX NG): the Subway app script compiles and runs in
+// the real script host, its @config header parses cleanly, and its settings reach the natives.
+// The natives are stubbed here; the device ones are in src/system/MtaFeedService.cpp.
+
+#include <unity.h>
+
+#include <string>
+
+#include "../ScriptApplication.h"
+#include "berry.h"
+#include "core/apps/AppRegistry.h"
+#include "core/apps/IApp.h"
+#include "core/render/Canvas.h"
+#include "core/script/BerryVM.h"
+#include "core/script/ScriptConfig.h"
+#include "core/script/ScriptHeap.h"
+#include "core/script/ScriptHost.h"
+#include "core/script/ScriptServices.h"
+#include "platform/linux/host/HostScriptHeap.h"
+#include "system/SubwayScript.h"
+
+using namespace awtrix;
+
+static long g_now = 0;
+static script::ScriptServices g_svc;
+static awtrix::test::ScriptApplication application;
+
+namespace {
+struct Stub {
+  std::string route, station, direction, url, drawRoute, layout;
+  long every = -1, stale = -1;
+  int drawArgs = -1;
+  bool verify = false, offlineArg = false, show = true;
+  int configs = 0, states = 0, draws = 0;
+};
+Stub g;
+
+int nConfig(bvm* vm) {
+  g.route = be_tostring(vm, 1);
+  g.station = be_tostring(vm, 2);
+  g.direction = be_tostring(vm, 3);
+  g.url = be_tostring(vm, 4);
+  g.every = static_cast<long>(be_toint(vm, 5));
+  g.stale = static_cast<long>(be_toint(vm, 6));
+  g.verify = be_tobool(vm, 7);
+  g.layout = be_top(vm) >= 8 ? be_tostring(vm, 8) : "(none)";
+  ++g.configs;
+  be_pushbool(vm, true);
+  be_return(vm);
+}
+int nState(bvm* vm) {
+  ++g.states;
+  be_pushstring(vm, g.states == 1 ? "loading" : "live");
+  be_return(vm);
+}
+int nShouldShow(bvm* vm) {
+  g.offlineArg = be_tobool(vm, 1);
+  be_pushbool(vm, g.show);
+  be_return(vm);
+}
+int nDraw(bvm* vm) {
+  ++g.draws;
+  g.drawRoute = be_tostring(vm, 1);
+  g.drawArgs = be_top(vm);
+  be_pushbool(vm, true);
+  be_return(vm);
+}
+int nStatus(bvm* vm) {
+  be_pushstring(vm, "status line");
+  be_return(vm);
+}
+
+void defineStubs(script::ScriptHost& host) {
+  host.defineNative("subway_config", &nConfig, nullptr);
+  host.defineNative("subway_state", &nState, nullptr);
+  host.defineNative("subway_should_show", &nShouldShow, nullptr);
+  host.defineNative("subway_draw", &nDraw, nullptr);
+  host.defineNative("subway_status", &nStatus, nullptr);
+}
+}  // namespace
+
+void setUp() {
+  g_now = 0;
+  g_svc = {};
+  application = {};
+  g_svc.application = &application;
+  g_svc.monotonicMs = [] { return g_now; };
+  g = Stub{};
+}
+void tearDown() { script::heap::testing::resetBudgetBytes(); }
+
+static void test_config_header_parses_cleanly() {
+  const script::ConfigSchema schema = script::parseConfig(kSubwayScript);
+  TEST_ASSERT_EQUAL_MESSAGE(0, schema.warnings.size(),
+                            schema.warnings.empty() ? "" : schema.warnings.front().c_str());
+  TEST_ASSERT_EQUAL(11, schema.fields.size());
+  for (const char* key : {"route", "station", "direction", "layout", "alerts", "offline", "dwell", "feed", "every", "stale", "verify"})
+    TEST_ASSERT_TRUE_MESSAGE(script::declares(schema, key), key);
+}
+
+static void test_installs_runs_and_passes_defaults_to_the_natives() {
+  AppRegistry reg;
+  script::ScriptHost host(reg, g_svc, nullptr, nullptr);
+  defineStubs(host);
+  TEST_ASSERT_TRUE_MESSAGE(host.set(kSubwayScriptName, kSubwayScript), host.lastRefusal().c_str());
+  TEST_ASSERT_TRUE(host.errorOf(kSubwayScriptName).empty());
+  TEST_ASSERT_EQUAL(1, g.configs);
+  TEST_ASSERT_EQUAL_STRING("B,C,A", g.route.c_str());
+  TEST_ASSERT_EQUAL_STRING("A21", g.station.c_str());
+  TEST_ASSERT_EQUAL_STRING("S", g.direction.c_str());
+  TEST_ASSERT_EQUAL_STRING("", g.url.c_str());  // automatic: the native picks the route's feed
+  TEST_ASSERT_EQUAL(30, g.every);
+  TEST_ASSERT_EQUAL(120, g.stale);
+  TEST_ASSERT_TRUE(g.verify);
+  TEST_ASSERT_EQUAL_STRING("numbers", g.layout.c_str());
+
+  // rotation hooks
+  TEST_ASSERT_TRUE(host.wantsShow(kSubwayScriptName));
+  TEST_ASSERT_TRUE(g.offlineArg);
+  g.show = false;
+  TEST_ASSERT_FALSE(host.wantsShow(kSubwayScriptName));
+
+  // loop() polls the state once a second, draw() hands the route and bullet color over
+  RenderCtx ctx;
+  for (int i = 0; i < 3; ++i) {
+    g_now += 1100;
+    host.tick(ctx, kSubwayScriptName);
+  }
+  TEST_ASSERT_TRUE(g.states >= 2);
+  TEST_ASSERT_EQUAL(10000, host.durationMs(kSubwayScriptName));  // read when it comes on screen
+  Canvas c(32, 8);
+  reg.find(kSubwayScriptName)->render(c, ctx);
+  TEST_ASSERT_EQUAL(1, g.draws);
+  TEST_ASSERT_EQUAL_STRING("B,C,A", g.drawRoute.c_str());
+  TEST_ASSERT_EQUAL(1, g.drawArgs);
+  TEST_ASSERT_TRUE(host.errorOf(kSubwayScriptName).empty());
+}
+
+static void test_settings_from_the_web_ui_reach_the_natives() {
+  AppRegistry reg;
+  script::ScriptHost host(reg, g_svc, nullptr, nullptr);
+  defineStubs(host);
+  const script::StorePatch p = script::applyConfigPatch(
+      script::parseConfig(kSubwayScript), "{}",
+      "{\"route\":\"6x\",\"station\":\"635\",\"direction\":\"N\",\"every\":45,\"stale\":300,\"verify\":false,"
+      "\"offline\":false,\"dwell\":5,\"feed\":\"https://example.test/feed\",\"layout\":\"turns\"}");
+  TEST_ASSERT_TRUE_MESSAGE(p.ok, p.message.c_str());
+  TEST_ASSERT_TRUE(host.set(kSubwayScriptName, kSubwayScript, p.storeJson));
+  TEST_ASSERT_EQUAL_STRING("6x", g.route.c_str());
+  TEST_ASSERT_EQUAL_STRING("635", g.station.c_str());
+  TEST_ASSERT_EQUAL_STRING("N", g.direction.c_str());
+  TEST_ASSERT_EQUAL_STRING("https://example.test/feed", g.url.c_str());
+  TEST_ASSERT_EQUAL(45, g.every);
+  TEST_ASSERT_EQUAL(300, g.stale);
+  TEST_ASSERT_FALSE(g.verify);
+  TEST_ASSERT_EQUAL_STRING("turns", g.layout.c_str());
+  host.wantsShow(kSubwayScriptName);
+  TEST_ASSERT_FALSE(g.offlineArg);
+  RenderCtx ctx;
+  g_now += 1100;
+  host.tick(ctx, kSubwayScriptName);
+  TEST_ASSERT_EQUAL(5000, host.durationMs(kSubwayScriptName));
+  Canvas c(32, 8);
+  reg.find(kSubwayScriptName)->render(c, ctx);
+  TEST_ASSERT_EQUAL_STRING("6x", g.drawRoute.c_str());
+}
+
+// The web UI clamps numbers to the header's min/max (upstream behaviour); the natives clamp again.
+static void test_out_of_range_settings_are_clamped_or_refused() {
+  const script::ConfigSchema schema = script::parseConfig(kSubwayScript);
+  const script::StorePatch fast = script::applyConfigPatch(schema, "{}", "{\"every\":5,\"stale\":10}");
+  TEST_ASSERT_TRUE(fast.ok);
+  TEST_ASSERT_TRUE_MESSAGE(fast.storeJson.find("\"every\":20") != std::string::npos, fast.storeJson.c_str());
+  TEST_ASSERT_TRUE_MESSAGE(fast.storeJson.find("\"stale\":60") != std::string::npos, fast.storeJson.c_str());
+  TEST_ASSERT_FALSE(script::applyConfigPatch(schema, "{}", "{\"station\":\"A21S_much_too_long_id\"}").ok);
+  TEST_ASSERT_FALSE(script::applyConfigPatch(schema, "{}", "{\"direction\":\"E\"}").ok);
+}
+
+int main() {
+  UNITY_BEGIN();
+  RUN_TEST(test_config_header_parses_cleanly);
+  RUN_TEST(test_installs_runs_and_passes_defaults_to_the_natives);
+  RUN_TEST(test_settings_from_the_web_ui_reach_the_natives);
+  RUN_TEST(test_out_of_range_settings_are_clamped_or_refused);
+  return UNITY_END();
+}
