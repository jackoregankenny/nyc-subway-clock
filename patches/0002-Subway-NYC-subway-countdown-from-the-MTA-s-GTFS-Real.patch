+// B-train gift clock addition (not upstream AWTRIX NG): GTFS-RT decoder, arrival board and the
+// 32x8 Subway layout.
+
+#include <unity.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include "core/render/Canvas.h"
+#include "core/transit/ArrivalBoard.h"
+#include "core/transit/GtfsRtDecoder.h"
+#include "core/transit/Gunzip.h"
+
+#include <zlib.h>
+#include "core/transit/Routes.h"
+#include "core/transit/SubwayView.h"
+#include "media/AwtrixFontAdapter.h"
+
+using namespace awtrix;
+using namespace awtrix::transit;
+
+void setUp() {}
+void tearDown() {}
+
+// ---------------------------------------------------------------- a tiny protobuf writer
+namespace pb {
+using Bytes = std::string;
+inline void varint(Bytes& o, uint64_t v) {
+  while (v >= 0x80) { o.push_back(static_cast<char>((v & 0x7F) | 0x80)); v >>= 7; }
+  o.push_back(static_cast<char>(v));
+}
+inline void tag(Bytes& o, uint32_t f, uint8_t w) { varint(o, (uint64_t{f} << 3) | w); }
+inline Bytes u(uint32_t f, uint64_t v) { Bytes o; tag(o, f, 0); varint(o, v); return o; }
+inline Bytes s(uint32_t f, const std::string& v) { Bytes o; tag(o, f, 2); varint(o, v.size()); o += v; return o; }
+inline Bytes m(uint32_t f, const Bytes& body) { return s(f, body); }
+inline Bytes f32(uint32_t f) { Bytes o; tag(o, f, 5); o.append(4, '\x11'); return o; }
+inline Bytes f64(uint32_t f) { Bytes o; tag(o, f, 1); o.append(8, '\x22'); return o; }
+}  // namespace pb
+
+using pb::Bytes;
+
+static Bytes header(uint64_t ts) { return pb::m(1, pb::s(1, "2.0") + pb::u(3, ts)); }
+static Bytes ev(int64_t t) { return pb::u(2, static_cast<uint64_t>(t)); }
+static Bytes stu(const std::string& stop, int64_t arr, int64_t dep = 0, int rel = -1) {
+  Bytes b = pb::s(4, stop);
+  if (arr) b += pb::m(2, ev(arr));
+  if (dep) b += pb::m(3, ev(dep));
+  if (rel >= 0) b += pb::u(5, static_cast<uint64_t>(rel));
+  return pb::m(2, b);
+}
+static Bytes trip(const std::string& route, int rel = -1) {
+  Bytes b = pb::s(1, "trip_" + route) + pb::s(5, route);
+  if (rel >= 0) b += pb::u(4, static_cast<uint64_t>(rel));
+  return pb::m(1, b);
+}
+static Bytes entity(const std::string& id, const Bytes& tripUpdate, bool deleted = false) {
+  Bytes b = pb::s(1, id) + pb::m(3, tripUpdate);
+  if (deleted) b += pb::u(2, 1);
+  return pb::m(2, b);
+}
+
+static GtfsRtDecoder decodeAll(const Bytes& feed, std::size_t chunk = 0, int64_t cutoff = 0,
+                               uint64_t maxBytes = 0, const char* route = "B", const char* stop = "A21S") {
+  GtfsRtDecoder d;
+  d.begin(route, stop, cutoff, maxBytes);
+  const auto* p = reinterpret_cast<const uint8_t*>(feed.data());
+  if (!chunk) chunk = feed.size() ? feed.size() : 1;
+  for (std::size_t i = 0; i < feed.size(); i += chunk)
+    d.feed(p + i, std::min(chunk, feed.size() - i));
+  d.finish();
+  return d;
+}
