+// Writes the 32x8 preview (ASCII and a scaled PPM per case) next to the build, for HANDOFF.
+// ---------------------------------------------------------------- two lines (B and C at 81 St)
+static std::string asciiBoard(const Canvas& c) {
+  std::string out;
+  for (int y = 0; y < c.height(); ++y) {
+    for (int x = 0; x < c.width(); ++x) {
+      const uint32_t p = c.getPixel(x, y);
+      out += p == 0 ? '.' : p == 0xEB6800u ? 'b' : p == 0x0062CFu ? 'c' : p == kNoDataText ? 'g' : '+';
+    }
+    out += '\n';
+  }
+  return out;
+}
+
+static Canvas renderTwo(const BoardView& b, const BoardView& cv, Layout layout = Layout::Numbers,
+                        int64_t nowMs = 0) {
+  Canvas c(32, 8);
+  c.clear();
+  const BoardView v[2] = {b, cv};
+  const SubwayStyle st[2] = {SubwayStyle::forRoute("B"), SubwayStyle::forRoute("C")};
+  renderBoard(c, awtrixFont(), v, st, 2, layout, nowMs);
+  return c;
+}
+
+static int countColor(const Canvas& c, uint32_t color) {
+  int n = 0;
+  for (int y = 0; y < c.height(); ++y)
+    for (int x = 0; x < c.width(); ++x) n += c.getPixel(x, y) == color;
+  return n;
+}
+
+// Columns of the runs of lit columns, left to right, with each run's color.
+static std::vector<std::pair<int, uint32_t>> runs(const Canvas& c) {
+  std::vector<std::pair<int, uint32_t>> out;
+  int x = 0;
+  while (x < c.width()) {
+    if (!columnLit(c, x)) { ++x; continue; }
+    uint32_t col = 0;
+    for (int y = 0; y < c.height() && !col; ++y) col = c.getPixel(x, y);
+    out.push_back({x, col});
+    int dark = 0;
+    while (x < c.width() && dark < 2) { dark = columnLit(c, x) ? 0 : dark + 1; ++x; }
+  }
+  return out;
+}
