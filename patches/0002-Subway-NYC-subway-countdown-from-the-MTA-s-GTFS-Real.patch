+// ---------------------------------------------------------------- arrival board
+static FeedSnapshot snap(std::vector<int64_t> times, int64_t feedTs = T0, bool ok = true) {
+  FeedSnapshot s;
+  s.everFinished = true;
+  s.lastOk = ok;
+  s.feedTimestamp = feedTs;
+  s.receivedEpoch = feedTs;
+  for (int64_t t : times) s.times[s.count++] = t;
+  return s;
+}
