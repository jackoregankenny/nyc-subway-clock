+constexpr int64_t T0 = 1794352000;
+
+// Two southbound B trains at A21S, interleaved with other routes, directions and stations.
+static Bytes mixedFeed() {
+  Bytes f = header(T0);
+  f += entity("1", trip("B") + stu("A20S", T0 + 100) + stu("A21S", T0 + 240) + stu("A22S", T0 + 400));
+  f += entity("2", trip("D") + stu("A21S", T0 + 120));               // other route, same stop
+  f += entity("3", trip("B") + stu("A21N", T0 + 60));                // northbound B
+  f += entity("4", trip("C") + stu("A21S", T0 + 90));
+  f += entity("5", trip("B") + stu("D14S", T0 + 30));                 // B elsewhere
+  f += entity("6", trip("B") + stu("A21S", T0 + 660));
+  f += entity("7", trip("BX") + stu("A21S", T0 + 70));                // prefix, not equal
+  return f;
+}
