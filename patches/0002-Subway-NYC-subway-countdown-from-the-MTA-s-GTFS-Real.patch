+static void test_nested_length_overrun() {
+  // an entity of 4 bytes whose inner trip_update claims 50
+  Bytes inner;
+  pb::tag(inner, 3, 2);
+  pb::varint(inner, 50);
+  inner += "ab";
+  Bytes f = header(T0) + pb::m(2, inner) + std::string(60, '\0');
+  TEST_ASSERT_EQUAL(DecodeError::LengthOverrun, decodeAll(f).error());
+  // a varint field that runs over the end of its message
+  Bytes e;
+  pb::tag(e, 2, 0);  // is_deleted, then the value byte falls outside
+  Bytes f2 = header(T0);
+  pb::tag(f2, 2, 2);
+  pb::varint(f2, 1);
+  f2 += e;
+  f2 += "\x01";
+  TEST_ASSERT_EQUAL(DecodeError::LengthOverrun, decodeAll(f2).error());
+  // a top-level length larger than the whole input is reported as truncated
+  Bytes f3 = header(T0);
+  pb::tag(f3, 2, 2);
+  pb::varint(f3, uint64_t{1} << 40);
+  TEST_ASSERT_EQUAL(DecodeError::Truncated, decodeAll(f3).error());
+}
