+      for (int b : ms) {
+        for (const BoardView& other : {live(b, 99), none}) {
+          Canvas c = renderTwo(live(a, b), other, lay, kTurnMs);
+          TEST_ASSERT_EQUAL_HEX32(0, c.getPixel(31, 0));
+          drawAlertDot(c);
+          TEST_ASSERT_EQUAL_HEX32(kAlertDot, c.getPixel(31, 0));
+        }
+        TEST_ASSERT_EQUAL_HEX32(0, renderView(live(a, b)).getPixel(31, 0));
+      }
+  // N, not NOW, in the dense layouts
+  Canvas c = renderTwo(live(0, 9), live(4, 14));
+  TEST_ASSERT_EQUAL(4, static_cast<int>(runs(c).size()));  // N 4 9 14: all four fit now
+}
+
+static void test_route_lists() {
+  std::string r[2];
+  TEST_ASSERT_EQUAL(2, parseRoutes("B,C", r, 2));
+  TEST_ASSERT_EQUAL_STRING("B", r[0].c_str());
+  TEST_ASSERT_EQUAL_STRING("C", r[1].c_str());
+  TEST_ASSERT_EQUAL(2, parseRoutes(" b + 6x ", r, 2));
+  TEST_ASSERT_EQUAL_STRING("6X", r[1].c_str());
+  TEST_ASSERT_EQUAL(1, parseRoutes("B", r, 2));
+  TEST_ASSERT_EQUAL(1, parseRoutes("B,b", r, 2));
+  TEST_ASSERT_EQUAL(2, parseRoutes("A/C/E", r, 2));
+  TEST_ASSERT_EQUAL(0, parseRoutes(" , ", r, 2));
+  std::string r3[3];
+  TEST_ASSERT_EQUAL(3, parseRoutes("B,C,A", r3, 3));
+  TEST_ASSERT_EQUAL_STRING("A", r3[2].c_str());
+  // B and C come from different feeds; A and C from the same one
+  TEST_ASSERT_TRUE(feedUrlFor("B") != feedUrlFor("C"));
+  TEST_ASSERT_TRUE(feedUrlFor("A") == feedUrlFor("C"));
+}
+
+static void test_write_preview() {
+  struct Case { const char* name; BoardView v; };
+  BoardView stale; stale.state = BoardState::Stale;
+  const Case cases[] = {
+      {"live_4_11", live(4, 11)}, {"now_8", live(0, 8)}, {"single_12", live(12)},
+      {"single_now", live(0)}, {"max_99_99", live(99, 99)}, {"stale_or_offline", stale},
+      {"route_Q_3_9", live(3, 9)}, {"route_1_now_6", live(0, 6)}, {"route_6X_2_14", live(2, 14)},
+      {"route_L_5_12", live(5, 12)}, {"route_A_7", live(7)},
+  };
+  BoardView none; none.state = BoardState::NoArrivals;
+  BoardView down; down.state = BoardState::Unavailable;
+  struct Two { const char* name; BoardView b, c; Layout layout; int64_t ms; bool alert = false; };
+  const Two twos[] = {{"bc_3_7_12_25", live(3, 25), live(7, 12), Layout::Numbers, 0},
+                      {"bc_now_4_9_14", live(0, 9), live(4, 14), Layout::Numbers, 0},
+                      {"bc_c_only_4_16", none, live(4, 16), Layout::Numbers, 0},
+                      {"bc_b_only_12", live(12), none, Layout::Numbers, 0},
+                      {"bc_offline", down, down, Layout::Numbers, 0},
+                      {"bc_bullets_3_7", live(3, 25), live(7, 12), Layout::Bullets, 0},
+                      {"bc_bullets_now_7", live(0, 25), live(7, 12), Layout::Bullets, 0},
+                      {"bc_turns_b_3_25", live(3, 25), live(7, 12), Layout::Turns, 0},
+                      {"bc_turns_c_7_12", live(3, 25), live(7, 12), Layout::Turns, kTurnMs},
+                      {"bc_alert_3_7_12_25", live(3, 25), live(7, 12), Layout::Numbers, 0, true}};
+  const char* dir = std::getenv("MTA_PREVIEW_DIR");
+  std::string all;
+  const int nCases = static_cast<int>(sizeof cases / sizeof cases[0]);
+  const int nTwos = static_cast<int>(sizeof twos / sizeof twos[0]);
+  for (int ci = 0; ci < nCases + nTwos; ++ci) {
+    const bool two = ci >= nCases;
+    std::string name = two ? twos[ci - nCases].name : cases[ci].name;
+    Canvas c(32, 8);
+    if (two) {
+      {
+        const Two& t = twos[ci - nCases];
+        c = renderTwo(t.b, t.c, t.layout, t.ms);
+        if (t.alert) drawAlertDot(c);
+      }
+      all += "== " + name + "\n" + asciiBoard(c);
+    } else {
+      std::string route = "B";
+      if (name.rfind("route_", 0) == 0) route = name.substr(6, name.find('_', 6) - 6);
+      c = renderView(cases[ci].v, route.c_str());
+      all += "== " + name + "\n" + ascii(c);
+    }
+    if (!dir) continue;
+    const int s = 12;
+    std::FILE* f = std::fopen((std::string(dir) + "/" + name + ".ppm").c_str(), "wb");
+    if (!f) continue;
+    std::fprintf(f, "P6\n%d %d\n255\n", 32 * s + 2 * s, 8 * s + 2 * s);
+    for (int py = 0; py < (8 + 2) * s; ++py)
+      for (int px = 0; px < (32 + 2) * s; ++px) {
+        const int x = px / s - 1, y = py / s - 1;
+        uint32_t p = 0x0A0A0A;
+        if (x >= 0 && y >= 0 && x < 32 && y < 8) {
+          const int dx = px % s - s / 2, dy = py % s - s / 2;
+          const bool dot = dx * dx + dy * dy <= (s * s) / 6;
+          p = dot ? (c.getPixel(x, y) ? c.getPixel(x, y) : 0x161616) : 0x0A0A0A;
+        }
+        const unsigned char rgb[3] = {static_cast<unsigned char>(p >> 16), static_cast<unsigned char>(p >> 8),
+                                      static_cast<unsigned char>(p)};
+        std::fwrite(rgb, 1, 3, f);
+      }
+    std::fclose(f);
+  }
+  if (dir) {
+    std::FILE* f = std::fopen((std::string(dir) + "/preview.txt").c_str(), "wb");
+    if (f) { std::fputs(all.c_str(), f); std::fclose(f); }
+  }
+  std::puts(all.c_str());
+}
+
+// The firmware links newlib's nano printf (scripts/newlib_nano.py): no 64-bit conversions. A %lld
+// shifts every later argument and the next %s dereferences garbage -- found on the TC001 as a boot
+// loop in subway_status(). The host printf hides it, so check the device sources directly.
+static void test_device_code_has_no_64_bit_printf() {
+  for (const char* path : {"src/system/MtaFeedService.cpp", "src/system/GiftDefaults.cpp"}) {
+    std::ifstream in(path);
+    TEST_ASSERT_TRUE_MESSAGE(in.good(), path);
+    const std::string src((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    std::size_t at = 0;
+    while ((at = src.find('%', at)) != std::string::npos) {
+      std::size_t k = at + 1;
+      while (k < src.size() && std::string("-+ #0123456789.").find(src[k]) != std::string::npos) ++k;
+      const bool bad = src.compare(k, 2, "ll") == 0 || src[k] == 'j' || src[k] == 'z';
+      TEST_ASSERT_FALSE_MESSAGE(bad, (std::string(path) + ": " + src.substr(at, 12)).c_str());
+      at = k;
+    }
+  }
+}
+
+int main() {
+  UNITY_BEGIN();
+  RUN_TEST(test_two_b_trains_among_others);
+  RUN_TEST(test_every_chunk_size_gives_the_same_answer);
+  RUN_TEST(test_fields_out_of_order);
+  RUN_TEST(test_unknown_fields_and_extensions_are_skipped);
+  RUN_TEST(test_departure_stands_in_for_missing_arrival);
+  RUN_TEST(test_skipped_cancelled_deleted_and_duplicates);
+  RUN_TEST(test_no_arrivals_is_not_an_error);
+  RUN_TEST(test_cutoff_and_keeps_the_earliest);
+  RUN_TEST(test_zero_length_fields);
+  RUN_TEST(test_long_ids_never_match);
+  RUN_TEST(test_truncation_anywhere_is_detected);
+  RUN_TEST(test_malformed_varints_and_wire_types);
+  RUN_TEST(test_nested_length_overrun);
+  RUN_TEST(test_oversized_input_is_cut_off);
+  RUN_TEST(test_large_feed_constant_memory);
+  RUN_TEST(test_real_mta_snapshot_matches_reference_decoder);
+  RUN_TEST(test_board_states);
+  RUN_TEST(test_board_countdown_ticks_between_polls);
+  RUN_TEST(test_board_is_utc_and_dst_proof);
+  RUN_TEST(test_backoff);
+  RUN_TEST(test_layout_is_centred_and_never_clips);
+  RUN_TEST(test_bullets);
+  RUN_TEST(test_no_data_shows_no_numbers);
+  RUN_TEST(test_every_route_maps_to_the_feed_that_carries_it);
+  RUN_TEST(test_stop_ids);
+  RUN_TEST(test_wrong_route_or_stop_is_told_apart_from_no_trains);
+  RUN_TEST(test_device_code_has_no_64_bit_printf);
+  RUN_TEST(test_two_lines_merge_in_time_order_by_color);
+  RUN_TEST(test_two_lines_never_clip_and_drop_what_does_not_fit);
+  RUN_TEST(test_two_lines_when_one_is_quiet_or_both_are_down);
+  RUN_TEST(test_two_line_layouts);
+  RUN_TEST(test_three_lines_overnight_a);
+  RUN_TEST(test_alerts_feed_matches_reference);
+  RUN_TEST(test_alert_dot_never_lands_on_text);
+  RUN_TEST(test_gzip_feed_decodes_like_the_plain_one);
+  RUN_TEST(test_gzip_survives_a_decoder_that_reads_ahead);
+  RUN_TEST(test_gzip_rejects_damage);
+  RUN_TEST(test_route_lists);
+  RUN_TEST(test_write_preview);
+  return UNITY_END();
+}
