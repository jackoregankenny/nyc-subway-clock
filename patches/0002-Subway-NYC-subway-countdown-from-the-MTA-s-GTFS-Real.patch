+  const std::string pic = asciiBoard(c);
+  const auto r = runs(c);
+  TEST_ASSERT_EQUAL_MESSAGE(4, static_cast<int>(r.size()), pic.c_str());
+  const uint32_t B = 0xEB6800u, C = 0x0062CFu;
+  TEST_ASSERT_EQUAL_HEX32(B, r[0].second);
+  TEST_ASSERT_EQUAL_HEX32(C, r[1].second);
+  TEST_ASSERT_EQUAL_HEX32(C, r[2].second);
+  TEST_ASSERT_EQUAL_HEX32(B, r[3].second);
+  TEST_ASSERT_EQUAL_MESSAGE(0, countColor(c, 0xFFFFFFu), pic.c_str());
+  for (int x = 0; x < 32; ++x) TEST_ASSERT_EQUAL_HEX32(0, c.getPixel(x, 7));
+  // centred
+  int first = 0, last = 31;
+  while (!columnLit(c, first)) ++first;
+  while (!columnLit(c, last)) --last;
+  TEST_ASSERT_TRUE_MESSAGE(first - (31 - last) >= -1 && first - (31 - last) <= 1, pic.c_str());
+}
