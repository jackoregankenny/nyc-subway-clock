+// ---------------------------------------------------------------- 32x8 layout
+static std::string ascii(const Canvas& c) {
+  std::string out;
+  for (int y = 0; y < c.height(); ++y) {
+    for (int x = 0; x < c.width(); ++x) {
+      const uint32_t p = c.getPixel(x, y);
+      out += p == 0 ? '.' : x < kBadgeW ? (p == kNoDataBadge ? 'g' : 'o') : p == 0xFFFFFFu ? '#' : '+';
+    }
+    out += '\n';
+  }
+  return out;
+}
