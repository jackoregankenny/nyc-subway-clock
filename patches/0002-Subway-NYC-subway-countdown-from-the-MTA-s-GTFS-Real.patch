+  const int64_t change = 1793512800;
+  const FeedSnapshot s = snap({change + 30 * 60}, change - 15 * 60);
+  const BoardView v = viewAt(s, change - 15 * 60, 120);
+  TEST_ASSERT_EQUAL(45, v.minutes[0]);
