+static void test_layout_is_centred_and_never_clips() {
+  const int cases[][2] = {{4, 11}, {0, 8}, {0, 99}, {9, 10}, {99, 99}, {10, 99}, {1, 1}, {0, 0},
+                          {12, -1}, {0, -1}, {99, -1}, {3, -1}};
+  for (const auto& k : cases) {
+    const Canvas c = renderView(live(k[0], k[1]));
+    const std::string pic = ascii(c);
+    int first = -1, last = -1;
+    for (int x = kBadgeW; x < 32; ++x)
+      if (columnLit(c, x)) { if (first < 0) first = x; last = x; }
+    // a dark column after the bullet, the group inside the panel, centred in cols 8-31
+    TEST_ASSERT_TRUE_MESSAGE(first >= kEtaLeft, pic.c_str());
+    TEST_ASSERT_TRUE_MESSAGE(last <= 31, pic.c_str());
+    const int leftMargin = first - kEtaLeft, rightMargin = 31 - last;
+    TEST_ASSERT_TRUE_MESSAGE(leftMargin - rightMargin >= -1 && leftMargin - rightMargin <= 1, pic.c_str());
+    // separate words: at least two runs of two or more dark columns inside the group
+    if ((k[1] >= 0 && !(k[0] == 0 && k[1] == 0)) || k[0] != 0) {
+      int gaps = 0, run = 0;
+      for (int x = first; x <= last; ++x) {
+        if (!columnLit(c, x)) ++run;
+        else { if (run >= 2) ++gaps; run = 0; }
+      }
+      // NOW . 99 is the one group that needs 1-px gaps
+      const bool tight = k[0] == 0 && k[1] == 99;
+      TEST_ASSERT_TRUE_MESSAGE(tight || gaps >= (k[1] >= 0 ? 2 : 1), pic.c_str());
+    }
+    // nothing on the bottom row; text rows 1-5 only
+    for (int x = 0; x < 32; ++x) TEST_ASSERT_EQUAL_HEX32(0, c.getPixel(x, 7));
+  }
+}
