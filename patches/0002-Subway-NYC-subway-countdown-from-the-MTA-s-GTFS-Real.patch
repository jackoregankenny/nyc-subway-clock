diff --git a/src/system/GiftDefaults.cpp b/src/system/GiftDefaults.cpp
new file mode 100644
index 0000000..b6f3d80
--- /dev/null
+++ b/src/system/GiftDefaults.cpp
@@ -0,0 +1,92 @@
+// B-train gift clock addition (not upstream AWTRIX NG). See GiftDefaults.h.
+
+#include "system/GiftDefaults.h"
+
+#include <Preferences.h>
+
+#include <string>
+
+#include "core/Settings.h"
+#include "core/script/IScriptFiles.h"
+#include "persistence/DeviceConfig.h"
+#include "persistence/NvsSettings.h"
+#include "system/Log.h"
+#include "system/SubwayScript.h"
+
+namespace awtrix::gift {
+
+namespace {
+constexpr const char* kNs = "btrain";
+constexpr const char* kSettingsKey = "defaults";  // 1 once the settings defaults were applied
+constexpr const char* kConfigKey = "config";      // 1 once the device config defaults were applied
+constexpr const char* kScriptKey = "subway";      // installed kSubwayScriptVersion
+}  // namespace
+
+bool applyConfigDefaults(DeviceConfig& cfg) {
+  Preferences p;
+  if (!p.begin(kNs, false)) return false;
+  const bool done = p.getInt(kConfigKey, 0) >= 1;
+  if (!done) {
+    cfg.tz = "EST5EDT,M3.2.0,M11.1.0";  // the web UI's own entry for America/New_York
+    cfg.tzName = "America/New_York";
+    if (cfg.save()) p.putInt(kConfigKey, 1);
+    logf("gift: first boot, timezone America/New_York");
+  }
+  p.end();
+  return !done;
+}
+
+// Versioned: each level is applied once, so a clock updated from an older build gets only the
+// new defaults and keeps whatever the user changed before.
+//   1  auto brightness on, volume 0, 12 h clock, M/D dates
+//   2  display off in a pitch-black room (darkOffLevel)
+constexpr int kSettingsLevel = 2;
+constexpr int kGiftDarkOffLevel = 1;  // percent light level: a dark bedroom reads below it
+
+bool applySettingsDefaults(Settings& s) {
+  Preferences p;
+  if (!p.begin(kNs, false)) return false;
+  const int level = p.getInt(kSettingsKey, 0);
+  if (level < 1) {
+    s.autoBrightness = true;
+    s.volume = 0;
+    s.time24h = false;
+    s.timeLeadingZero = false;
+    s.dateOrder = kDateOrderMDY;
+    s.dateSeparator = kDateSepSlash;
+    logf("gift: first boot, auto brightness on, volume 0, 12 h clock, M/D dates");
+  }
+  if (level < 2) {
+    s.darkOffLevel = kGiftDarkOffLevel;
+    logf("gift: display off below %d %% light", kGiftDarkOffLevel);
+  }
+  if (level < kSettingsLevel) {
+    nvs::saveSettings(s);
+    p.putInt(kSettingsKey, kSettingsLevel);
+  }
+  p.end();
+  return level < kSettingsLevel;
+}
+
+bool installSubwayApp(script::IScriptFiles& files) {
+  Preferences p;
+  if (!p.begin(kNs, false)) return false;
+  const int installed = p.getInt(kScriptKey, 0);
+  bool wrote = false;
+  if (installed < kSubwayScriptVersion) {
+    files.save(kSubwayScriptName, kSubwayScript);
+    std::string check;
+    wrote = files.readSource(kSubwayScriptName, check) && check == kSubwayScript;
+    // Only remembered once it is really on flash: a full filesystem retries on the next boot.
+    if (wrote) {
+      p.putInt(kScriptKey, kSubwayScriptVersion);
+      logf("gift: Subway app v%d installed", kSubwayScriptVersion);
+    } else {
+      logf("gift: could not write the Subway app, retrying next boot");
+    }
+  }
+  p.end();
+  return wrote;
+}
+
+}  // namespace awtrix::gift
diff --git a/src/system/GiftDefaults.h b/src/system/GiftDefaults.h
new file mode 100644
index 0000000..0345204
--- /dev/null
+++ b/src/system/GiftDefaults.h
@@ -0,0 +1,36 @@
+#pragma once
+
+// B-train gift clock addition (not upstream AWTRIX NG).
+//
+// First-boot defaults for the gift, each applied once and remembered in NVS (namespace "btrain"),
+// so whatever the recipient changes later sticks:
+//   - timezone America/New_York (upstream defaults to Europe/Berlin)
+//   - US clock face: 12-hour time without a leading zero, month/day dates
+//   - auto brightness on (the light sensor dims the panel in a dark bedroom)
+//   - master volume 0 (no beeps; raise it on the web UI's Settings tab)
+//   - the Subway app installed into the script store (src/system/SubwayScript.h)
+// A factory reset wipes NVS and the scripts, so it brings these defaults back on the next boot.
+// Re-provisioning Wi-Fi (select held at power-on) does not touch any of it.
+
+namespace awtrix {
+
+struct Settings;
+class DeviceConfig;
+
+namespace script {
+class IScriptFiles;
+}
+
+namespace gift {
+
+// Right after DeviceConfig::load(), before the time is configured. True when it changed something.
+bool applyConfigDefaults(DeviceConfig& cfg);
+
+// Before the settings are first applied to the hardware. True when it changed something.
+bool applySettingsDefaults(Settings& s);
+
+// Before the stored scripts are restored. True when it (re)installed the Subway app.
+bool installSubwayApp(script::IScriptFiles& files);
+
+}  // namespace gift
+}  // namespace awtrix
